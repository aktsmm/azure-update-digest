{
  "name": "azure-update-digest",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "description": "Azure Update Digest: collect Azure updates from Microsoft Release Communications MCP and publish a static Japanese digest site.",
  "scripts": {
    "collect": "tsx src/cli/collect.ts",
    "normalize": "tsx src/cli/normalize.ts",
    "build:site": "tsx src/cli/build-site.ts",
    "validate": "tsx src/cli/validate.ts",
    "pending": "tsx src/cli/pending.ts",
    "pending-slides": "tsx src/cli/pending-slides.ts",
    "slide-input": "tsx src/cli/slide-input.ts",
    "validate:slides": "tsx src/cli/validate-slides.ts",
    "pdf": "tsx src/cli/render-pdf.ts",
    "protect:pdfs": "tsx src/cli/protect-pdfs.ts",
    "build:api": "tsx src/cli/build-api.ts",
    "build:pdfs": "tsx src/cli/build-slide-pdfs.ts",
    "build": "npm run normalize && npm run build:site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright-core": "^1.65.0-alpha-2026-10-07"
  }
}
