        { "termKey": "application-gateway", "term": "Application Gateway", "type": "product", "oneLine": { "text": "Web アプリへの通信を管理する、Web トラフィック用のロード バランサー。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/application-gateway/overview", "locator": "冒頭", "retrievedAt": "2026-10-14T12:00:00Z" }] } },
        { "termKey": "azure-front-door", "term": "Azure Front Door", "type": "product", "oneLine": { "text": "Web アプリの入口となる、グローバルでスケーラブルなサービス。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/security/fundamentals/network-overview#azure-front-door", "locator": "Azure Front Door", "retrievedAt": "2026-10-14T12:00:00Z" }] } },
        { "termKey": "false-positive", "term": "誤検知", "type": "term", "oneLine": { "text": "安全で予期される要求を、WAF がブロックしてしまうこと。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/application-gateway-exceptions", "locator": "冒頭", "retrievedAt": "2026-10-14T12:00:00Z" }] } },
        { "termKey": "label-ga", "term": "GA（一般提供）", "type": "label", "oneLine": { "text": "機能が完全にリリースされ、本番利用でサポートされる段階。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/lifecycle/faq/azure-infrastructure", "locator": "General availability (GA)", "retrievedAt": "2026-10-14T12:00:00Z" }] } }
      ],
