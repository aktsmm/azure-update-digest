      "title": {
        "ja": "Foundry の「エージェント分析情報（insights）」が一般提供（GA）に",
        "subtitleJa": "エージェントのトレースから繰り返す問題を見つけ、優先して直す点を判断できます",
        "en": "Generally Available: Agent insights in Microsoft Foundry"
      },
      "meta": {
        "publishedJst": "2026-11-24",
        "modifiedJst": "2026-11-24",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Microsoft Foundry"],
        "categories": ["ai"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "Microsoft Foundry で**エージェントを運用している開発者・運用担当者**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "トレースから繰り返す失敗パターンを把握し、改善の優先順位を決められる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "運用中のエージェントがあれば、トレースを確認して試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": { "text": "分析情報がトレースの繰り返しパターンを抽出し、関連する問題をまとめる。agent optimizer で修正案を昇格前に検証できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Application Insights のトレースから、繰り返す失敗・幻覚・トークンのスパイクなどを分析情報として表示",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/observability/how-to/agent-insights", "locator": "Foundry が分析情報を生成する方法", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "各分析情報に代表的なトレース、影響を受けるバージョン、考えられる原因、推奨アクションを含められる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/observability/how-to/agent-insights", "locator": "冒頭", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "agent optimizer で選んだ分析情報の修正候補を作成・評価し、昇格前に確認できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "最適化の実行を作成する", "retrievedAt": "2026-11-26T02:40:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方（Foundry ポータル）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "エージェントの [トレース] で最近のトレースを確認し、ポータルでインサイト スキャンを実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/observability/how-to/agent-insights", "locator": "トレースの準備状態を確認する", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "[分析情報] タブで内容とトレースを確認し、修正する分析情報を選んで [分析情報の修正] を実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "最適化の実行を作成する", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "「Insights improved」を主指標にし、全体品質も確認してから候補を昇格",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "結果を理解する", "retrievedAt": "2026-11-26T02:40:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "GPT-5 以降の GPT モデルのデプロイと、接続された Application Insights が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/observability/how-to/agent-insights", "locator": "前提条件", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "初回は 7 日間のルックバックで既存トレースを分析。トレースの欠落は品質低下の要因",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/observability/how-to/agent-insights", "locator": "Foundry が分析情報を生成する方法", "retrievedAt": "2026-11-26T02:40:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "agent optimizer との関係", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "分析情報の修正はプレビュー。ポータルの対象は Copilot ハーネスを使わないプロンプト エージェント",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "冒頭", "retrievedAt": "2026-11-26T02:40:00Z" }]
            },
            {
              "text": "候補が変更できるのはエージェント命令とツールの説明で、モデルやスキルは変更不可",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "候補をレビューして昇格させる", "retrievedAt": "2026-11-26T02:40:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "本番トラフィックの失敗パターンから、先に直す点を決める", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            {
              "text": "ツールが本番システムを変更できる場合、最適化の実行で意図しない変更が起こり得る。読み取り専用か分離環境を使う",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/optimize-agents-from-insights", "locator": "最適化の実行を作成する", "retrievedAt": "2026-11-26T02:40:00Z" }]
            }
          ]
        }
      ],
