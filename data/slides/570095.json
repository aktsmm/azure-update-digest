      "title": {
        "ja": "AKS の Artifact Streaming が一般提供（GA）に",
        "subtitleJa": "ACR のイメージをストリーミングして、ポッドの起動とスケールを高速化",
        "en": "Generally Available: Artifact Streaming on AKS"
      },
      "meta": {
        "publishedJst": "2026-09-02",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "July" }],
        "status": "Launched",
        "products": ["Azure Kubernetes Service (AKS)"],
        "categories": ["compute", "containers"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "ACR（Premium）と連携した **AKS で大きなイメージを使う方**", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "前提条件 / 制限事項", "retrievedAt": "2026-10-18T21:40:00Z" }] },
        "change": { "text": "イメージのプル完了を待たずにワークロードをスケールできる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "起動の遅さが課題なら検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": {
          "text": "標準の起動では、ワークロード開始前にすべてのイメージ レイヤーをダウンロードする",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "アーティファクト ストリーミングのしくみ", "retrievedAt": "2026-10-18T21:40:00Z" }]
        },
        "after": {
          "text": "最初のポッドの起動に必要なレイヤーのみ取得し、残りは必要に応じて後で取得する",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "アーティファクト ストリーミングのしくみ", "retrievedAt": "2026-10-18T21:40:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "イメージ レイヤーを OverlayBD で仮想ブロック デバイスに変換",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "アーティファクト ストリーミングのしくみ", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "起動時・実行時にアクセスされるブロックだけを取得",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "アーティファクト ストリーミングのしくみ", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "タグ指定のプルをストリーミング版イメージに解決して動作",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "Note", "retrievedAt": "2026-10-18T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure CLI）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "ACR（Premium）で az acr artifact-streaming create を実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "ACR で成果物ストリーミングを有効にする", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "ノード プールで az aks nodepool add / update に --enable-artifact-streaming",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "AKS で成果物ストリーミングを有効にする", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "az aks nodepool show の artifactStreamingProfile で状態を確認",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "有効化の状態を確認する", "retrievedAt": "2026-10-18T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Premium SKU の ACR を AKS と統合、Kubernetes 1.25 以降、Azure CLI 2.87.0 以降",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "前提条件 / 制限事項", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "Linux AMD64 のみ。Windows / ARM64 / CMK レジストリは非対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming", "locator": "制限事項", "retrievedAt": "2026-10-18T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "標準のプルとの違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "標準: 全レイヤーを取得後に起動 / Artifact Streaming: 必要なレイヤーのみで起動",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "アーティファクト ストリーミングのしくみ", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "元のイメージとストリーミング版の両方を ACR に保持できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "Considerations", "retrievedAt": "2026-10-18T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "大きなイメージや、複数ポッドのスケール時の起動遅延を減らす",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "利点とユース ケース", "retrievedAt": "2026-10-18T21:40:00Z" }]
            },
            {
              "text": "起動時に多くのファイルを読む読み取り負荷の高いイメージは効果が出ない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/artifact-streaming-overview", "locator": "Considerations", "retrievedAt": "2026-10-18T21:40:00Z" }]
            }
          ]
        }
      ],
