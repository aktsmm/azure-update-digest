      "action": {
        "required": "yes",
        "summary": { "text": "Pod 名ディメンションを使う場合のみ、期限までにダッシュボード等を更新する（集計のみなら対応不要）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
