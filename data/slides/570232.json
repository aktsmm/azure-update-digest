      "panels": [
        {
          "id": "impact", "heading": "知っておきたいこと", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は kube_pod_status_phase と kube_pod_status_ready の 2 メトリック", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "移行期間中は、既存と新しい集計の両実装にデータが入り、既存の監視は動作する", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "廃止までに、集計実装で 1 年以上の履歴データが蓄積される", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
