      },
      "beforeAfter": {
        "before": {
          "text": "kube_pod_status_phase は phase / namespace / pod、kube_pod_status_ready は namespace / pod / condition のディメンションを持つ",
          "origin": "learn",
          "assertion": "fact",
          "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/monitor-aks-reference", "locator": "Metrics", "retrievedAt": "2026-10-14T19:32:07Z" }]
        },
        "after": { "text": "pod ディメンションは利用不可（絞り込み・グループ化・アラート不可）。集計 Pod 数は利用可", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
