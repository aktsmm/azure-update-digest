            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/http3-quic-support", "locator": "Important", "retrievedAt": "2026-10-21T21:40:00Z" }]
          },
          {
            "q": "どう有効化しますか？",
