      "kindSource": "ring",
      "label": "GA",
      "title": {
        "ja": "Azure SQL Database のベクター検索とベクター インデックスが GA に",
        "subtitleJa": "CREATE VECTOR INDEX と VECTOR_SEARCH で、別のベクター DB なしに近似最近傍検索ができます",
        "en": "Generally Available: Vector search and vector indexes in Azure SQL"
      },
      "meta": {
        "publishedJst": "2026-09-29",
        "modifiedJst": "2026-09-29",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "September" }],
        "status": "Launched",
        "products": ["Azure SQL Database"],
        "categories": ["databases"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "**Azure SQL Database で RAG・セマンティック検索などの AI アプリを作る方**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "企業データのある DB 内でベクター検索でき、構成がシンプルになる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "AI 検索を DB 内で実装したい場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": {
          "text": "DiskANN ベースのベクター インデックスで、大規模データでも効率的な近似最近傍（ANN）検索ができ、リレーショナルクエリやフィルターとも組み合わせられる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "ベクター インデックスは DiskANN アルゴリズムに基づくグラフ構造で、近い一致を高速に探索する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/ai/vectors?view=azuresqldb-current", "locator": "近似ベクトル インデックスとベクトル検索", "retrievedAt": "2026-10-15T17:20:00Z" }]
            },
            {
              "text": "ANN は精度（再現率）を一部譲る代わりに、kNN より大幅に高速で省リソース",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/ai/vectors?view=azuresqldb-current", "locator": "近似ベクトル インデックスとベクトル検索", "retrievedAt": "2026-10-15T17:20:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始め方（T-SQL）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "CREATE VECTOR INDEX で METRIC（cosine / dot / euclidean）を指定してインデックスを作成",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "構文 / METRIC", "retrievedAt": "2026-10-15T17:20:00Z" }]
            },
            {
              "text": "SELECT TOP (N) WITH APPROXIMATE と VECTOR_SEARCH で近似検索を実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "例", "retrievedAt": "2026-10-15T17:20:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ベクター インデックスは分割できず、レプリケートもされない。TRUNCATE TABLE も不可",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "現在の制限事項", "retrievedAt": "2026-10-15T17:20:00Z" }]
            },
            {
              "text": "DacPac ではデプロイできない。Bacpac は DacFx 170.5.96 以降で可能",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "現在の制限事項", "retrievedAt": "2026-10-15T17:20:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "VECTOR_DISTANCE の正確検索（kNN）は全件比較。約 5 万件未満なら正確検索を推奨",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/ai/vectors?view=azuresqldb-current", "locator": "正確な検索とベクトルの距離", "retrievedAt": "2026-10-15T17:20:00Z" }]
            },
            {
              "text": "最新のインデックスは INSERT / UPDATE / DELETE / MERGE に対応（旧版は読み取り専用）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "完全な DML サポート", "retrievedAt": "2026-10-15T17:20:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "セマンティック検索、RAG、レコメンド、画像検索など、DB 内のデータを AI で検索する場面",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            },
            {
              "text": "旧構文の TOP_N は最新インデックスではエラー。TOP (N) WITH APPROXIMATE を使う",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/t-sql/statements/create-vector-index-transact-sql?view=azuresqldb-current", "locator": "従来の構文を使用したエラー", "retrievedAt": "2026-10-15T17:20:00Z" }]
            }
          ]
        }
      ],
