      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "最初のエージェント作成日から最大 30 日間、常時稼働料金が免除",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "試用版に含まれる内容", "retrievedAt": "2026-10-21T22:36:00Z" }]
            },
            {
              "text": "エージェントが作業した分の AAU（アクティブ使用）のみ課金",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "Azure SRE Agentの料金設定", "retrievedAt": "2026-10-21T22:36:00Z" }]
            },
            {
              "text": "試用中に機能制限はなく、条件は課金面のみ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "制限はありますか?", "retrievedAt": "2026-10-21T22:36:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "対象リージョンでエージェントを作成し、運用ツールやデータソースに接続",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "始める前に", "retrievedAt": "2026-10-21T22:36:00Z" }]
            },
            {
              "text": "まず 1 つのエージェントと、よく知るサービス・問題から評価",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "評価時に試すべきこと", "retrievedAt": "2026-10-21T22:36:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "対象は初めて使うお客様。1 アカウントあたり最大 3 エージェント（削除分も数える）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "試用版に含まれる内容", "retrievedAt": "2026-10-21T22:36:00Z" }]
            },
            {
              "text": "作成には所有者、または共同作成者＋ユーザー アクセス管理者が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "始める前に", "retrievedAt": "2026-10-21T22:36:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "試用終了後との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "終了後は常時稼働料金（エージェント時間あたり 4 AAU）が自動で適用",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [
                { "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/pricing-billing", "locator": "常時稼働フロー", "retrievedAt": "2026-10-21T22:36:00Z" },
                { "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "試用期間が終了したら", "retrievedAt": "2026-10-21T22:36:00Z" }
              ]
            },
            {
              "text": "停止ではアクティブ使用のみ止まり、削除で全課金が止まる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/pricing-billing", "locator": "アクションによる課金の影響", "retrievedAt": "2026-10-21T22:36:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "アラート・ログ・メトリクスから根本原因と緩和策を調査させる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/evaluate", "locator": "評価時に試すべきこと", "retrievedAt": "2026-10-21T22:36:00Z" }]
            },
            {
              "text": "月間 AAU 上限（500〜1,000,000）でアクティブ使用を抑えられる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/pricing-billing", "locator": "アクティブなフローの使用制限を設定する", "retrievedAt": "2026-10-21T22:36:00Z" }]
            }
          ]
        }
