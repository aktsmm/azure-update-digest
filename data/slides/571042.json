      "audience": {
        "who": { "text": "**Azure Database for PostgreSQL フレキシブル サーバー**の運用・性能調査を担当する方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "性能問題の根本原因を、スケールアップ前に特定して対処しやすくなる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": {
          "text": "障害調査の前にテレメトリ（診断設定・クエリ ストア）を有効化しておく",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "前提条件", "retrievedAt": "2026-10-16T06:50:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "メトリック・セッション・クエリ統計・ログを 1 つのビューで関連付けて診断",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/concepts-troubleshooting-guides", "locator": "冒頭", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "症状の確認 → 原因の特定 → 修正の適用、という診断パスで進める",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/concepts-troubleshooting-guides", "locator": "冒頭", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "対象は CPU・メモリ・IOPS・一時ファイル・autovacuum の 6 種のガイド",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/concepts-troubleshooting-guides", "locator": "ガイドを選択する", "retrievedAt": "2026-10-16T06:50:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始める流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "事前に診断設定（Log Analytics）とクエリ ストア関連のサーバー パラメーターを有効化",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "前提条件", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "Azure portal で対象サーバー → [監視] → [トラブルシューティング ガイド] を開く",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "ガイドを開く", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "調査する問題のタブを選び、分析する時間範囲を設定する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "ガイドを開く", "retrievedAt": "2026-10-16T06:50:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "有効化後に蓄積したデータのみ対象。時間範囲の最小は 1 時間",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "前提条件 / ガイドを開く", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "Burstable ではクエリ ストアは非推奨。読み取りレプリカは対応するが挙動が異なる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/concepts-troubleshooting-guides", "locator": "制限事項", "retrievedAt": "2026-10-16T06:50:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "関連するツール", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure メトリックは「何が起きたか」、ガイドは原因のクエリ・待機・設定まで特定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/concepts-troubleshooting-guides", "locator": "メトリックチャートでは得られない、ガイドが提供するもの", "retrievedAt": "2026-10-16T06:50:00Z" }]
            },
            {
              "text": "手動調査では pg_stat_statements やクエリ ストアで高負荷クエリを確認できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-high-cpu-utilization", "locator": "高い CPU 使用率を識別するためのツール", "retrievedAt": "2026-10-16T06:50:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "CPU 高騰時に、増強の前に原因クエリや接続数を確認する",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            },
            {
              "text": "空のグラフはデータ ソース未有効化の可能性があり、正常を意味しない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/troubleshoot/how-to-troubleshooting-guides", "locator": "グラフが空であるか、データが間違って見える場合", "retrievedAt": "2026-10-16T06:50:00Z" }]
            }
          ]
        }
