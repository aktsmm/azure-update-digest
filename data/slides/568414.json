      "kindSource": "ring",
      "label": "GA",
      "title": {
        "ja": "PostgreSQL の論理レプリケーション スロット同期状態メトリックが GA",
        "subtitleJa": "スロットごとの同期状態を Azure Monitor で確認し、アラートも設定できます",
        "en": "Generally Available: Logical replication slot sync status metric for Azure PostgreSQL Flexible Server"
      },
      "meta": {
        "publishedJst": "2026-09-19",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "September" }],
        "status": "Launched",
        "products": ["Azure Database for PostgreSQL"],
        "categories": ["databases"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "**フレキシブル サーバーで論理レプリケーション／CDC（Debezium・Kafka など）を使っている方**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "スロットごとの同期状態を可視化し、メンテナンスや移行時の準備状況をアラートで把握できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "論理レプリケーションを運用中ならアラート設定を検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure Monitor メトリック logical_replication_slot_sync_status を追加", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "HA のプライマリとスタンバイ間でスロットが同期されているかを表示（1: 同期、0: 非同期）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/monitor/concepts-monitoring", "locator": "論理レプリケーション スロット同期の状態", "retrievedAt": "2026-10-15T19:00:00Z" }] },
            { "text": "値 0 は、フェールオーバーに対して安全でない可能性を示す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/monitor/concepts-monitoring", "locator": "論理レプリケーション スロット同期の状態", "retrievedAt": "2026-10-15T19:00:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始めるには", "availability": "present", "priority": "core",
          "items": [
            { "text": "パラメーター metrics.collector_database_activity を on にして出力する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/monitor/concepts-monitoring", "locator": "論理レプリケーション スロット同期の状態", "retrievedAt": "2026-10-15T19:00:00Z" }] },
            { "text": "メトリックにはアラートを構成できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/monitor/concepts-monitoring", "locator": "Metrics", "retrievedAt": "2026-10-15T19:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ネイティブのスロット同期は PostgreSQL 17 以降。sync_replication_slots などの設定が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-logical", "locator": "論理レプリケーションスロットのフェールオーバー対応", "retrievedAt": "2026-10-15T19:00:00Z" }] },
            { "text": "同期されるのは、フェールオーバー オプション付きで作成したスロットのみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-logical", "locator": "論理レプリケーションスロットのフェールオーバー対応", "retrievedAt": "2026-10-15T19:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "logical_replication_delay_in_bytes は全スロットの最大ラグ。今回はスロットごとの同期状態", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/monitor/concepts-monitoring", "locator": "拡張メトリック", "retrievedAt": "2026-10-15T19:00:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "フェールオーバーや計画メンテナンスの前に、同期状態をアラートで確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            { "text": "PostgreSQL 16 以前の HA では、フェールオーバー時にスロットが保持されない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-logical", "locator": "スロットと HA フェールオーバー", "retrievedAt": "2026-10-15T19:00:00Z" }] }
          ]
        }
      ],
