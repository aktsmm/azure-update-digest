          "items": [
            { "text": "新しいドメイン・エンドポイントでの mTLS 有効化が推奨されている", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "コンフィギュレーションの手順", "retrievedAt": "2026-10-25T22:14:00Z" }] },
            { "text": "検証モードと CA 証明書の運用（自動ローテーションなし）を検証環境で確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
