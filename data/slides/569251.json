        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "検証モードは4種: 必須+検証 / 必須のみ / 提示時のみ検証 / オリジンへ通過", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "相互TLS検証モード", "retrievedAt": "2026-10-25T22:14:00Z" }] },
            { "text": "公的 CA・プライベート CA 発行の証明書に対応。CA チェーンは Key Vault に保存", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "mTLSは公開証明書とプライベート証明書の両方をサポートしていますか?", "retrievedAt": "2026-10-25T22:14:00Z" }] },
            { "text": "証明書は X-Azure-ClientCertificate ヘッダーでオリジンへ転送", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "相互TLS検証モード", "retrievedAt": "2026-10-25T22:14:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "既存ドメインで mTLS を有効化・無効化するとダウンタイムが発生", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "重要な設計上の考慮事項", "retrievedAt": "2026-10-25T22:14:00Z" }] },
            { "text": "mTLS 有効時は、ルートでキャッシュを有効にできない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "重要な設計上の考慮事項", "retrievedAt": "2026-10-25T22:14:00Z" }] },
            { "text": "CA 証明書は PEM で 25 KB 未満、ルート＋中間証明書は最大 3 つ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/mutual-tls", "locator": "構成クォータの上限", "retrievedAt": "2026-10-25T22:14:00Z" }] }
          ]
        },
