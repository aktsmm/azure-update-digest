        "categories": ["compute", "containers", "ops-governance", "devtools"],
        "importance": "normal"
      },
      "audience": {
        "who": { "text": "Prometheus メトリックを Azure Monitor ワークスペースへ取り込む**運用担当者（AKS 利用者を含む）**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "取り込み上限が使用量に追従し、上限の手動管理やスロットリングの懸念を減らせる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Autoscale ingestion limits in Azure Monitor workspace (Preview)", "retrievedAt": "2026-11-15T22:40:00Z" }] },
