      },
      "beforeAfter": {
        "before": {
          "text": "既定の上限は 100 万アクティブ時系列・1 分あたり 100 万イベント。引き上げはサポート チケットなどで依頼",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Ingestion limits", "retrievedAt": "2026-11-15T22:40:00Z" }]
        },
        "after": {
          "text": "有効化すると、使用量の増加で上限が上がり、低使用が続くと下がる",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Autoscale ingestion limits in Azure Monitor workspace (Preview)", "retrievedAt": "2026-11-15T22:40:00Z" }]
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "ワークスペース単位で、取り込み上限（クォータ上限）を使用状況に応じて自動調整", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "使用量が上限に近づくと引き上げ、低使用が続くと未使用分を回収（取り込みへの影響なし）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Turn on autoscale for your workspace", "retrievedAt": "2026-11-15T22:40:00Z" }] },
            { "text": "上限の変更はワークスペースのアクティビティ ログに記録される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Monitor scale change in the Activity Log", "retrievedAt": "2026-11-15T22:40:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "オプトイン。ARM API で properties.limits.enableAutoScale=true を設定して有効化", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Turn on autoscale for your workspace", "retrievedAt": "2026-11-15T22:40:00Z" }] },
            { "text": "課金は変わらず、実際の取り込み量に基づく。無効化（false）すると上限は固定に戻る", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Note / Turn on autoscale", "retrievedAt": "2026-11-15T22:40:00Z" }] }
          ]
        },
        { "id": "ga-timing", "heading": "GA の時期", "availability": "not-stated", "priority": "core" },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "スロットリングや上限引き上げ依頼が発生していないか確認し、検証用ワークスペースで試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            { "text": "75% / 95% 超過の推奨アラート規則で、使用率を併せて監視できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-monitor/metrics/azure-monitor-workspace-monitor-ingest-limits", "locator": "Alerts", "retrievedAt": "2026-11-15T22:40:00Z" }] }
          ]
        }
