      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Azure portal の VM 作成ページまたは Azure SQL ハブから開始できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-vm-create-portal-quickstart?view=azuresql", "locator": "Linux VM の作成", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "VM は SQL Server IaaS Agent 拡張機能に既定で自動登録される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-server-on-linux-vm-what-is-iaas-overview?view=azuresql", "locator": "自動登録", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "ライセンスは従量課金（既定）か Azure ハイブリッド特典を選択",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-vm-create-portal-quickstart?view=azuresql", "locator": "SQL Server 設定の構成", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "対応 OS は RHEL 9/10 と Ubuntu 22.04/24.04/26.04。SLES は未対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-server-on-linux-vm-what-is-iaas-overview?view=azuresql", "locator": "サポートされているLinuxディストリビューション", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "SLES では SLES の VM を作成し、SQL Server を手動でインストールする",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-server-on-linux-vm-what-is-iaas-overview?view=azuresql", "locator": "SQL Serverを手動でインストールしてください", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "Azure ハイブリッド特典には Software Assurance の License Mobility が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-vm-create-portal-quickstart?view=azuresql", "locator": "ライセンスモデル", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        { "id": "ga-timing", "heading": "GA の時期", "availability": "not-stated", "priority": "core" },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "使う OS・SQL Server バージョンが対応範囲か、検証用 VM で確認する",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            },
            {
              "text": "検証・機能テストは DS2 以上、性能テストは DS13 以上の VM サイズが目安",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/linux/sql-vm-create-portal-quickstart?view=azuresql", "locator": "ヒント", "retrievedAt": "2026-10-14T22:30:00Z" }]
