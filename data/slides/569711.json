      "kindSource": "ring",
      "label": "Preview",
      "title": {
        "ja": "Azure VM のディスクごとの回復性がパブリック プレビュー",
        "subtitleJa": "障害時に影響を受けたデータ ディスクだけをオフラインにし、VM は稼働を継続",
        "en": "Public Preview: Per-disk resiliency for Azure VMs"
      },
      "meta": {
        "publishedJst": "2026-09-01",
        "modifiedJst": "2026-09-01",
        "availability": [{ "rawRing": "Preview", "year": 2026, "month": "August" }],
        "status": "In preview",
        "products": ["Azure Disk Storage"],
        "categories": ["storage"],
        "importance": "normal"
      },
      "audience": {
        "who": { "text": "**データ ディスクを複数使う VM**（コンテナー ノード、共有ディスク クラスター等）の運用者", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "1 つのデータ ディスクの障害で VM 全体が再起動しなくなる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "既定動作は変わらない。使うにはプレビュー登録とディスクごとの有効化が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency-configure", "locator": "ディスクごとの回復性プレビューに登録する", "retrievedAt": "2026-10-21T21:50:00Z" }] }
      },
      "beforeAfter": {
        "before": { "text": "ディスクへの接続が長時間失われると、VM がシャットダウンされ、復旧後に再起動する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "冒頭", "retrievedAt": "2026-10-21T21:50:00Z" }] },
        "after": { "text": "有効化したデータ ディスクのみデタッチされ、VM と他のディスクは稼働を継続。復旧後に自動で再アタッチ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性のしくみ", "retrievedAt": "2026-10-21T21:50:00Z" }] }
      },
      "panels": [
        {
          "id": "scope", "heading": "仕組みと対象", "availability": "present", "priority": "core",
          "items": [
            { "text": "ディスクの actionOnDiskDelay を AutomaticReattach にすると有効化（既定は None）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性のしくみ", "retrievedAt": "2026-10-21T21:50:00Z" }] },
            { "text": "I/O 遅延がしきい値を超えると、そのディスクだけがデタッチされ、VM は再起動しない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性のしくみ", "retrievedAt": "2026-10-21T21:50:00Z" }] },
            { "text": "ディスクがオフラインの間、そのディスクへの I/O はエラーを返す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性シーケンスの例", "retrievedAt": "2026-10-21T21:50:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "データ ディスクのみ対象。OS ディスクは従来どおり VM が再起動する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性の制限", "retrievedAt": "2026-10-21T21:50:00Z" }] },
            { "text": "2026 年 8 月 15 日より前にサポート リージョンで作成された VM は非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性の制限", "retrievedAt": "2026-10-21T21:50:00Z" }] },
            { "text": "VM 作成時は有効化不可。Azure ポータル非対応。書き込みアクセラレータ有効 VM も非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性の制限", "retrievedAt": "2026-10-21T21:50:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "向くのは、コンテナーのノード、クラスター化／共有ディスク、運用 VM のバックアップ ディスク", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性のユース ケース", "retrievedAt": "2026-10-21T21:50:00Z" }] },
            { "text": "ディスクのオフライン中に返る I/O エラーを、アプリが処理できるか確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        },
        {
          "id": "backup", "heading": "バックアップと復元", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Azure Backup / Site Recovery で復元した後は、ディスクに設定を再度行う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性の制限", "retrievedAt": "2026-10-21T21:50:00Z" }] }
          ]
        },
        {
          "id": "regions", "heading": "プレビューの対象リージョン", "availability": "present", "priority": "detail",
          "items": [
            { "text": "東日本、東アジア、東南アジア、韓国中部、米国西部 など 18 リージョン", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-per-disk-resiliency", "locator": "ディスクごとの回復性をサポートするリージョン", "retrievedAt": "2026-10-21T21:50:00Z" }] }
          ]
        }
      ],
