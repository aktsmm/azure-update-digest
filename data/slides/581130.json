      "kindSource": "ring",
      "label": "GA",
      "title": {
        "ja": "AKS の機密 VM ノード プールで Intel TDX が一般提供（GA）に",
        "subtitleJa": "AMD SEV-SNP と並んで Intel TDX を選べます。追加の AKS 設定や API は不要です",
        "en": "Generally Available: Confidential VMs with Intel TDX support on AKS"
      },
      "meta": {
        "publishedJst": "2026-11-18",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Azure Kubernetes Service (AKS)"],
        "categories": ["compute", "containers"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "Intel TDX を基準に機密ワークロードを運用している **AKS ユーザー**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "アテステーション モデルを変えずに機密ワークロードを AKS に移せる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "Intel TDX で標準化している場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": { "text": "CVM ノード イメージは AMD SEV-SNP のみに対応しており、Intel TDX のワークロードは機密 VM ノード プールで実行できなかった", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "after": { "text": "機密 VM ノード プールで Intel TDX と AMD SEV-SNP の両方を利用でき、VM SKU から適切な CVM イメージが自動選択される", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "VM SKU に応じて適切な CVM イメージが自動で選択される", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "CVM はハイパーバイザーやホスト管理コードから VM のメモリと状態へのアクセスを拒否する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "冒頭", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "CVM ノード上のすべての Pod は同じ信頼境界に含まれる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "それはどのように動作しますか?", "retrievedAt": "2026-11-19T01:50:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "az aks nodepool add の --node-vm-size に機密 VM サイズを指定する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "CVM を持つノード プールを AKS クラスターに追加する", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "Intel TDX のサイズは DCesv6 / DCedsv6 / ECesv6 / ECedsv6 シリーズ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/confidential-computing/virtual-machine-options", "locator": "サイズ", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "az aks nodepool show で vmSize と nodeImageVersion を確認できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "ノード プールで CVM が使用されていることを確認する", "retrievedAt": "2026-11-19T01:50:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "対象リージョンのサブスクリプションで CVM サイズが使え、十分なクォータがあること",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "前提条件", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "Intel TDX の VM サイズには Ubuntu 26.04（プレビュー）の CVM ノード プールが必要と記載されている",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "サポートされている OS のバージョン", "retrievedAt": "2026-11-19T01:50:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "AMD SEV-SNP は第 3 世代 AMD EPYC、Intel TDX は第 5 世代 Intel Xeon で導入された技術",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/confidential-computing/virtual-machine-options", "locator": "冒頭", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "CVM は VM サイズの機能に従い、個別にオン・オフできない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "制限事項", "retrievedAt": "2026-11-19T01:50:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "機密性の高い顧客データや、コンプライアンス要件のあるワークロードで CVM が必要になる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "冒頭", "retrievedAt": "2026-11-19T01:50:00Z" }]
            },
            {
              "text": "Ubuntu / Azure Linux の CVM ノード プールでは FIPS や Pod sandboxing は使えない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-cvm", "locator": "制限事項", "retrievedAt": "2026-11-19T01:50:00Z" }]
            }
          ]
        }
      ],
