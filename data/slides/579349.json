      "title": {
        "ja": "Azure DocumentDB の M10〜M30 がほぼ即時プロビジョニングに（GA）",
        "subtitleJa": "従来は無料レベルのみだった即時作成が、M10〜M30 のクラスターにも拡大",
        "en": "Generally Available: Near-instant provisioning for Azure DocumentDB clusters"
      },
      "meta": {
        "publishedJst": "2026-11-18",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Azure DocumentDB"],
        "categories": ["databases"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "Azure DocumentDB で検証・開発・本番の立ち上げを行う**開発者・AI エージェント利用者**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "クラスター作成の待ち時間を抑えて試せる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "no",
        "summary": { "text": "新規作成時に自動で適用。必要なら M10 で試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": {
          "text": "即時プロビジョニングは無料レベルのみ。クラスターの利用開始まで 10〜15 分待つ必要があった",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        },
        "after": {
          "text": "M10〜M30 のレベルでも、ほぼ即時にクラスターをプロビジョニングできる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は M10〜M30 のクラスター レベル。待ち時間なしで検証を開始できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "M10 は基本的な機能テストや実験、M30 は本番向けの標準的な入口", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "[リソースの作成] で Azure DocumentDB を選び、[クラスター層] で M10〜M30 を構成して作成",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/documentdb/quickstart-portal", "locator": "クラスターの作成", "retrievedAt": "2026-11-19T01:38:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "M10 は 1 vCore・2 GiB RAM、M30 は 2 vCore・8 GiB RAM（シャードあたり）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/documentdb/compute-storage", "locator": "Azure DocumentDB でのコンピューティング", "retrievedAt": "2026-11-19T01:38:00Z" }]
            },
            {
              "text": "前提は Azure サブスクリプションのみ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/documentdb/quickstart-portal", "locator": "Prerequisites", "retrievedAt": "2026-11-19T01:38:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "M10・M20・M25 はバースト可能（アイドル時は CPU を抑え、負荷時にフル性能）、M30 は固定の 2 vCore",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/documentdb/compute-storage", "locator": "バーストが可能なコンピューティングとは", "retrievedAt": "2026-11-19T01:38:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "AI エージェントがクラスター作成を待たずに実験を始められる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "成長に応じて、より上位のクラスター レベルへスケールできる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        }
      ],
