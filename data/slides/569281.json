      "action": {
        "required": "optional",
        "summary": { "text": "容量不足に備えて、拡張手順を確認しておくと安心", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": {
          "text": "共有 Premium SSD v2 / Ultra データ ディスクを、アプリを中断せずに動的に拡張できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "VM の割り当て解除なしで、ディスク サイズを拡張できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "ダウンタイムなしで拡張する", "retrievedAt": "2026-10-28T22:40:00Z" }] },
            { "text": "拡張は Azure portal / Azure CLI / Azure PowerShell で実行", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "Ultra Disks と Premium SSD v2 で拡張する", "retrievedAt": "2026-10-28T22:40:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始める流れ", "availability": "present", "priority": "core",
          "items": [
            { "text": "az disk update などでディスクを拡張し、OS 側でも領域を認識させる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "Azure CLIを使用してAzureマネージド ディスクを展開する", "retrievedAt": "2026-10-28T22:40:00Z" }] },
            { "text": "VM に正しいサイズが反映されるまで最大 10 分。必要に応じて再スキャンを実行", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "Ultra Disks と Premium SSD v2 で拡張する", "retrievedAt": "2026-10-28T22:40:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ディスクでデータのバックグラウンド コピー中は拡張できない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "Ultra Disks と Premium SSD v2 で拡張する", "retrievedAt": "2026-10-28T22:40:00Z" }] },
            { "text": "データ ディスクのみ対象。最新の CLI / PowerShell、または API 2021-04-01 以降が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/linux/expand-disks", "locator": "ダウンタイムなしで拡張する", "retrievedAt": "2026-10-28T22:40:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "関連する仕様", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Premium SSD v2 は容量・IOPS・スループットをいつでも個別に調整できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-types", "locator": "プレミアムSSD v2", "retrievedAt": "2026-10-28T22:40:00Z" }] },
            { "text": "共有ディスクは VM ごとの追加料金なし。課金は容量・IOPS・MB/秒", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-shared", "locator": "共有 Ultra Disk と共有 Premium SSD v2 の価格", "retrievedAt": "2026-10-28T22:40:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "まず小さな共有ディスクで始め、データ増加に合わせて拡張する", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "共有ディスクには WSFC や Pacemaker などのクラスター マネージャーが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/disks-shared", "locator": "冒頭", "retrievedAt": "2026-10-28T22:40:00Z" }] }
          ]
        }
      ],
