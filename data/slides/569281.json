      "audience": {
        "who": { "text": "共有ディスク（Premium SSD v2 / Ultra）でクラスターを組んでいる方", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "ダウンタイムなしで容量を増やせるため、コストを抑えた運用ができる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
