        {
          "id": "how-to-start", "heading": "使い始める流れ", "availability": "present", "priority": "core",
          "items": [
            { "text": "初回利用前にウェイトリストのリクエストを送信し、機能登録を受ける", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes-requirements-considerations", "locator": "ブレークスルー モードに登録する", "retrievedAt": "2026-10-15T17:00:00Z" }] },
            { "text": "登録状態は Get-AzProviderFeature（ANFBreakthroughMode）や az feature show で確認", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes-requirements-considerations", "locator": "ブレークスルー モードに登録する", "retrievedAt": "2026-10-15T17:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "移行アシスタントは非対応。スナップショットを新ボリュームへ復元不可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes-requirements-considerations", "locator": "ブレークスルー モードの要件と考慮事項", "retrievedAt": "2026-10-15T17:00:00Z" }] },
            { "text": "専用キャパシティの発注・プロビジョニング済みのリージョンで利用可能", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "通常ボリューム: 最大 100 TiB / 大容量: 50 TiB～1 PiB、12,800 MiB/秒上限 / ブレークスルー: 上限なし（最大 80 GiB/s）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes", "locator": "大量の容量には以下の制限があります", "retrievedAt": "2026-10-15T17:00:00Z" }] },
            { "text": "通常ボリュームを大容量ボリュームへ変換することはできない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes-requirements-considerations", "locator": "要件と考慮事項", "retrievedAt": "2026-10-15T17:00:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "HPC / EDA など、大容量を超えるスループットと並行性が必要なケース", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes", "locator": "ワークロードの種類とユースケース", "retrievedAt": "2026-10-15T17:00:00Z" }] },
