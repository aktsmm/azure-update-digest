      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "1 ボリュームにつき 6 つのストレージ エンドポイントを使い、性能を安定させる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "顧客ごとに予約された専用キャパシティで、他のワークロードと競合しない", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
