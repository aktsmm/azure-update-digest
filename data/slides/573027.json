        "who": { "text": "HPC や EDA など高スループットが必要な **Azure NetApp Files の利用者**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "専用キャパシティで他の負荷の影響を受けにくく、安定した高性能を得られる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
