      "beforeAfter": {
        "before": {
          "text": "大容量ボリュームの性能上限は全サービス レベルで 12,800 MiB/秒",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes", "locator": "大量の容量には以下の制限があります", "retrievedAt": "2026-10-15T17:00:00Z" }]
        },
        "after": {
          "text": "ブレークスルー モードでは定義済みの上限に縛られず、ワークロード次第で単一ボリュームで最大 80 GiB/s",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/large-volumes", "locator": "大量の容量には以下の制限があります", "retrievedAt": "2026-10-15T17:00:00Z" }]
