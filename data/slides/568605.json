              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-network/virtual-network-routing-appliance-overview", "locator": "高可用性と負荷分散のガイダンス", "retrievedAt": "2026-10-28T23:25:00Z" }]
