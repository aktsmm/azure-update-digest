            {
              "text": "NSG・UDR・NAT Gateway などの VNet 機能をネイティブにサポート",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-network/virtual-network-routing-appliance-overview", "locator": "Azureネイティブ管理モデル", "retrievedAt": "2026-10-28T23:25:00Z" }]
