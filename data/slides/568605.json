              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-network/virtual-network-routing-appliance-overview", "locator": "制限事項", "retrievedAt": "2026-10-28T23:25:00Z" }]
            },
            {
              "text": "VNet フローログ未対応。通過トラフィックは VNet 暗号化の対象外",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-network/virtual-network-routing-appliance-overview", "locator": "制限事項", "retrievedAt": "2026-10-28T23:25:00Z" }]
            }
          ]
        },
