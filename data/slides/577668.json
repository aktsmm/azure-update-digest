      "speakerNotes": {
        "qa": [
          {
            "q": "既存の Front Door プロファイルは移行が必要ですか？",
            "a": "不要です。既存プロファイルは後方互換性のため既定で Standard になります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "ポリシーのオプション", "retrievedAt": "2026-11-09T00:00:00Z" }]
          },
          {
            "q": "ポスト量子鍵交換はオリジンとの通信にも効きますか？",
            "a": "いいえ。クライアントから Front Door の接続のみが対象で、オリジンへの接続には鍵交換ポリシーを設定しません。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "接続範囲", "retrievedAt": "2026-11-09T00:00:00Z" }]
          },
          {
            "q": "設定時に気を付ける点は？",
            "a": "クライアントが対応するグループを残してください。TLS 1.2 を許可する場合は古典的グループを含め、事前に代表的なクライアントで検証します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "互換性と展開の考慮事項", "retrievedAt": "2026-11-09T00:00:00Z" }]
          }
        ]
