      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "ポリシーは Standard / Enhanced / Custom から選択。Custom では X25519 も選べる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "ポリシーのオプション", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "ハイブリッド方式は古典的鍵交換と ML-KEM を組み合わせ、TLS 1.3 が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "TLSのバージョン互換性", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "対象はクライアントから Front Door の接続のみ。オリジン接続は対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "接続範囲", "retrievedAt": "2026-11-09T00:00:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            { "text": "カスタム ドメイン単位で Standard / Enhanced / Custom を選び、Custom はグループを選択", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "鍵交換ポリシーの設定", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "本番利用の前に、代表的なクライアントで接続をテストする", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "鍵交換ポリシーの設定", "retrievedAt": "2026-11-09T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "既定の Front Door ドメインは常に Standard で、ポリシーを変更できない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "ポリシーのオプション", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "TLS 1.2 を許可するなら、Custom に古典的グループを 1 つ以上含める", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "TLSのバージョン互換性", "retrievedAt": "2026-11-09T00:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "TLS ポリシー: バージョンと暗号スイート / 鍵交換ポリシー: 対応グループを制御", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-policy", "locator": "冒頭", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "最小 TLS を 1.3 にすると、TLS_AES_128_GCM_SHA256 を無効化できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "まず Standard から始め、要件がある場合に Enhanced / Custom を検討する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "互換性と展開の考慮事項", "retrievedAt": "2026-11-09T00:00:00Z" }] },
            { "text": "クライアントが対応する鍵交換を全て除外すると、接続できなくなる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/tls-key-exchange-policy", "locator": "Warning", "retrievedAt": "2026-11-09T00:00:00Z" }] }
