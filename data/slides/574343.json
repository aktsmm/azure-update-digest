        { "termKey": "waf-policy", "term": "WAF ポリシー", "type": "feature", "oneLine": { "text": "WAF のルールセットや例外などの設定をまとめたもの。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/application-gateway-exceptions", "locator": "WAF ポリシーに例外を適用する", "retrievedAt": "2026-10-14T14:29:00Z" }] } },
        { "termKey": "false-positive", "term": "誤検知", "type": "term", "oneLine": { "text": "安全で予期される要求を、WAF がブロックしてしまうこと。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/application-gateway-exceptions", "locator": "冒頭", "retrievedAt": "2026-10-14T14:29:00Z" }] } }
