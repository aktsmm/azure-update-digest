      "speakerNotes": {
        "qa": [
          {
            "q": "日本リージョンで使えますか？",
            "a": "プライベート エンドポイントは HorizonDB が使えるリージョンで利用可能で、HorizonDB の提供リージョンには Japan East が含まれます。",
            "evidence": [
              { "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/network/concepts-network-private-link" },
              { "url": "https://learn.microsoft.com/azure/horizondb/overview/overview" }
            ]
          },
          {
            "q": "作成するとパブリック アクセスは止まりますか？",
            "a": "止まりません。プライベート接続のみにするには、クラスターの publicAccess プロパティを Disabled に設定します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/network/concepts-network-private-link" }]
          },
          {
            "q": "読み取り専用エンドポイントにも使えますか？",
            "a": "使えますが、1 つのプライベート エンドポイントは 1 つのエンドポイントのみ対応です。両方に接続するには 2 つ作成します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/network/concepts-network-private-link" }]
          }
        ]
