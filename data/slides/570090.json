      "speakerNotes": {
        "qa": [
          {
            "q": "どの Kubernetes バージョンで使えますか？",
            "a": "Windows Server 2025 は Kubernetes 1.32.0 以降でサポートされます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-windows-os", "locator": "制限事項", "retrievedAt": "2026-10-18T21:40:00Z" }]
          },
          {
            "q": "既存の 2022 ノード プールは作り直しが必要ですか？",
            "a": "2022 から 2025 へは az aks nodepool update でインプレース移行できます。非対応構成は新規ノード プールへ手動移行します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-windows-os", "locator": "インプレース移行", "retrievedAt": "2026-10-18T21:40:00Z" }]
          },
          {
            "q": "Windows Server 2022 はいつまで使えますか？",
            "a": "2028 年 6 月 30 日から、AKS はノード プールの Windows Server 2022 をサポートしなくなります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-windows-os", "locator": "Important", "retrievedAt": "2026-10-18T21:40:00Z" }]
          }
        ]
