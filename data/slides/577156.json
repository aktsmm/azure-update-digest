      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "リクエスト元 IP が属するサービス タグを特定し、ルールの値と照合",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "サービスタグマッチングの仕組み", "retrievedAt": "2026-10-26T00:00:00Z" }]
            },
            {
              "text": "タグの IP プレフィックスは Microsoft が自動更新するため、ルール修正は不要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "サービスタグマッチングの仕組み", "retrievedAt": "2026-10-26T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "カスタム ルールで一致変数を SocketAddr か RemoteAddr、演算子を ServiceTagMatch に設定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "サービスタグマッチ条件の設定", "retrievedAt": "2026-10-26T00:00:00Z" }]
            },
            {
              "text": "Azure portal では一覧からタグを選択（1 条件で複数選択可）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "サービスタグマッチ条件の設定", "retrievedAt": "2026-10-26T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "対象は Front Door Premium。タグ名は完全一致で、ワイルドカードや正規表現は不可",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "冒頭 / サービスタグマッチ条件の設定", "retrievedAt": "2026-10-26T00:00:00Z" }]
            },
            {
              "text": "一致変数は SocketAddr（接続元）か RemoteAddr（X-Forwarded-For 由来）のみ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "適切なマッチ変数を選ぶ", "retrievedAt": "2026-10-26T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "NSG は Front Door 背後のオリジンでは元クライアント IP を評価できず、Azure 外のオリジンには使えない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "なぜサービスタグがAzure Front Doorで有用なのか", "retrievedAt": "2026-10-26T00:00:00Z" }]
            },
            {
              "text": "WAF で評価するため、元のクライアント接続に対して制御できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "なぜサービスタグがAzure Front Doorで有用なのか", "retrievedAt": "2026-10-26T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "許可・ブロック・管理パスの制限・レート制限に利用できる",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            },
            {
              "text": "AzureCloud など広いタグは影響範囲が大きい。最も狭いタグを選び、検出モードで確認してから適用",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/service-tag-match-condition", "locator": "Considerations", "retrievedAt": "2026-10-26T00:00:00Z" }]
            }
          ]
        }
