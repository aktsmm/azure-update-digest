      "panels": [
        {
          "id": "how-it-works",
          "heading": "仕組み",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "Azure 外（データセンター・エッジ・他社クラウド）の SQL Server に Azure サービスを拡張",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/overview?view=sql-server-ver17",
                  "locator": "冒頭",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            },
            {
              "text": "Azure portal で名前・バージョン・エディション等を確認し、Resource Graph で横断クエリ",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/overview?view=sql-server-ver17",
                  "locator": "単一の管理ポイントから SQL Server インスタンスを大規模に管理する",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "始め方",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "Azure サブスクリプションと Arc エージェントを用意し、リソース プロバイダーを登録",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/prerequisites?view=sql-server-ver17",
                  "locator": "デプロイする前に",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            },
            {
              "text": "登録対象は Microsoft.AzureArcData と Microsoft.HybridCompute",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/prerequisites?view=sql-server-ver17",
                  "locator": "リソース プロバイダーを登録する",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            },
            {
              "text": "Arc 対応サーバーと SQL Server インスタンスには同じリージョンを割り当てる",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/prerequisites?view=sql-server-ver17",
                  "locator": "サポートされているリージョン",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            }
          ]
        },
        {
          "id": "prerequisites-limits",
          "heading": "前提・制限",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "SQL Server 2014 以降（64 ビット）。Windows Server 2016 以降、Ubuntu 20.04、RHEL 8、SLES 15 など",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/prerequisites?view=sql-server-ver17",
                  "locator": "サポートされる構成",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            },
            {
              "text": "コンテナー上や Azure VM 上の SQL Server は非対応。Private Link も使えない",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/prerequisites?view=sql-server-ver17",
                  "locator": "サポートされていない構成",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            }
          ]
        },
        {
          "id": "related-features",
          "heading": "関連機能",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "ベスト プラクティス評価、Microsoft Entra 認証、Defender for Cloud、Purview と連携できる",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/overview?view=sql-server-ver17",
                  "locator": "各機能の節",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            },
            {
              "text": "Microsoft Entra 認証には SQL Server 2022 以降が必要",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/overview?view=sql-server-ver17",
                  "locator": "Microsoft Entra認証",
                  "retrievedAt": "2026-10-14T21:00:00Z"
                }
              ]
            }
          ]
        },
        {
          "id": "use-case",
          "heading": "使いどころ",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "ドイツ西中部の環境にある SQL Server を Azure から一元管理したい場合に向く",
              "origin": "editorial",
              "assertion": "recommendation",
              "verification": "unverified"
            },
            {
              "text": "導入前にサポート リージョン一覧と構成の制限を確認する",
              "origin": "editorial",
