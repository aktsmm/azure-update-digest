              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/shareable-link", "locator": "考慮事項", "retrievedAt": "2026-10-21T22:10:00Z" }]
            },
            {
              "text": "Virtual WAN、テナント間ピアリング、オンプレミス VM は非対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/shareable-link", "locator": "考慮事項", "retrievedAt": "2026-10-21T22:10:00Z" }]
