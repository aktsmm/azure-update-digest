              "text": "[共有可能リンク] → [+ 追加] でリソースと有効期限を選び [適用]",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/shareable-link", "locator": "共有可能リンクを作成する", "retrievedAt": "2026-10-21T22:10:00Z" }]
            }
          ]
        },
