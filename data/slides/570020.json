      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "リンク作成時に、リンクが期限切れになる日時を指定する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/shareable-link", "locator": "共有可能なリンクの有効期限を設定する", "retrievedAt": "2026-10-21T22:10:00Z" }]
            },
            {
              "text": "期限を過ぎるとリンクは接続に使えず、状態は「リンクの期限切れ」に変わる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/shareable-link", "locator": "共有可能なリンクの有効期限を設定する", "retrievedAt": "2026-10-21T22:10:00Z" }]
