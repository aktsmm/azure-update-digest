      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "アプリのコード・構成・依存関係を評価し、クラウド準備スコアを生成",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/overview", "locator": "アプリケーション評価", "retrievedAt": "2026-11-23T00:10:00Z" }]
            },
            {
              "text": "DB ワークフローは 2 つ: SQL Server の移行準備評価、Oracle から PostgreSQL へのアプリ移行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/overview", "locator": "データベースのモダン化 (プレビュー)", "retrievedAt": "2026-11-23T00:10:00Z" }]
            },
            {
              "text": "計画は実行前に確認・編集でき、実行後はビルドと検証チェックを実施",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/overview", "locator": "インテリジェントな計画 / 自律実行", "retrievedAt": "2026-11-23T00:10:00Z" }]
            }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "SQL Server 評価は Windows でのローカル実行のみ。Linux / macOS は非対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/assess-sql-server", "locator": "Prerequisites", "retrievedAt": "2026-11-23T00:10:00Z" }]
            },
            {
              "text": "SQL Server 評価は DB を移行せず、Azure リソースも作成しない（準備状況の評価のみ）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/assess-sql-server", "locator": "Important", "retrievedAt": "2026-11-23T00:10:00Z" }]
            },
            {
              "text": "Oracle 変換はローカルの PostgreSQL コンテナーで検証。DB サーバーや顧客データは移行されない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/overview", "locator": "データベースのモダン化 (プレビュー)", "retrievedAt": "2026-11-23T00:10:00Z" }]
            }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "SQL Server の移行先として Hyperscale が評価対象。Managed Instance や SQL Server on VM も代替パスとして残る",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/github-copilot-app-modernization/modernization-agent/assess-sql-server", "locator": "冒頭", "retrievedAt": "2026-11-23T00:10:00Z" }]
            },
            {
              "text": "対象アプリが DB 依存を持つか確認し、検証用リポジトリで対話型（TUI）から試す",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            }
          ]
        }
