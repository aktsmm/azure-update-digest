      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "コントロール プレーンは Anyscale がホストし、Azure ポータルや CLI/SDK で操作", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "どのように機能するのか", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "データ プレーンは自分の AKS クラスター上で動き、データはテナント内に残る", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "どのように機能するのか", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "Microsoft Entra ID シングル サインオンとマネージド ID でアクセス制御", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "主要プラットフォームの機能", "retrievedAt": "2026-10-14T21:36:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure CLI で Anyscale サービス プリンシパルを作成し、リソース プロバイダーを登録", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/quickstart-azure-cli", "locator": "Azure サブスクリプションの構成", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "AKS クラスターを作成し、Azure ポータルで Anyscale クラウド リソースを作成", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/quickstart-azure-cli", "locator": "Anyscale クラウド リソースを作成する", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "Envoy Gateway などのゲートウェイを導入し、Platform Contributor ロールを付与", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/quickstart-azure-cli", "locator": "チームにアクセス権を割り当てる", "retrievedAt": "2026-10-14T21:36:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "AKS ベースのみ対応。クラウドの作成・削除は Azure ポータルが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "Limitations", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "クロスリージョン レプリケーションやマルチリージョン クラスターは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/supported-regions", "locator": "地域ごとの振る舞いと制約", "retrievedAt": "2026-10-14T21:36:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "関連する機能", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Blob Storage / ADLS、Container Registry、Load Balancer と連携", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "Azure サービス統合", "retrievedAt": "2026-10-14T21:36:00Z" }] },
            { "text": "複数のクラウド リソースを追加でき、ジョブはリソース間でフェイルオーバー可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/overview", "locator": "マルチリソースクラウドサポート", "retrievedAt": "2026-10-14T21:36:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "データ準備、分散学習、ファインチューニング、推論を 1 つの Ray プログラムで構成", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "制御プレーンは米国で動作し運用メタデータが流れるため、規制要件は事前確認", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/anyscale-on-azure/supported-regions", "locator": "データ駐留と制御プレーン", "retrievedAt": "2026-10-14T21:36:00Z" }] }
          ]
        }
