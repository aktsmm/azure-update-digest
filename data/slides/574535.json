      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "既存の Burstable モデルを基にした拡張ティア（Basv2）がパブリック プレビューで提供される", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Burstable の VM シリーズは B シリーズと Basv2 シリーズ。Basv2 は 2〜32 vCore の SKU", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "コンピューティング オプション表", "retrievedAt": "2026-11-26T03:30:00Z" }] },
            { "text": "Basv2 SKU は最大 25,600 IOPS・600 MiB/秒（B16as_v2 / B32as_v2）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "バースト対応 v2", "retrievedAt": "2026-11-26T03:30:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "Burstable は CPU クレジット モデル。クレジットが尽きるとベースライン CPU に制限される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "バースト可能", "retrievedAt": "2026-11-26T03:30:00Z" }] },
            { "text": "主に開発・ステージング・テストなど非運用環境向け。業務プロセスには非推奨", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "Important", "retrievedAt": "2026-11-26T03:30:00Z" }] },
            { "text": "リージョン表では Basv2 は西日本が対象で、東日本の Burstable 欄は非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/overview", "locator": "Azure リージョン", "retrievedAt": "2026-11-26T03:30:00Z" }] }
          ]
        },
        { "id": "ga-timing", "heading": "GA の時期", "availability": "not-stated", "priority": "core" },
        {
