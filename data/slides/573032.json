              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/manage-cool-access", "locator": "クール アクセスの一般的な考慮事項", "retrievedAt": "2026-10-15T17:10:00Z" }]
