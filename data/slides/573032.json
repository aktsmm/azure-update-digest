      },
      "beforeAfter": {
        "before": {
          "text": "更新前にクール アクセスを有効にしたボリュームは、TiB あたり Premium 36 / Ultra 68 MiB/秒の旧 QoS 制限が適用される",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Premium および Ultra サービス レベルのスループット", "retrievedAt": "2026-10-15T17:10:00Z" }]
        },
        "after": {
          "text": "クール層のデータ量に基づき一定間隔で調整。ホット層は 64 / 128、クール層は 16 MiB/秒（TiB あたり）で計算",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Premium および Ultra サービス レベルのスループット", "retrievedAt": "2026-10-15T17:10:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "クール層のデータ量に基づき、スループット上限が一定間隔で調整される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Premium および Ultra サービス レベルのスループット", "retrievedAt": "2026-10-15T17:10:00Z" }]
            },
            {
              "text": "Premium の上限 = ホット TiB × 64 + クール TiB × 16 MiB/秒",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "スループット制限の計算表", "retrievedAt": "2026-10-15T17:10:00Z" }]
            },
            {
              "text": "例: ホット 8 TiB・クール 2 TiB なら最大 544 MiB/秒",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Premium サービス レベルの例", "retrievedAt": "2026-10-15T17:10:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "容量プールの作成時に「クール アクセスを有効にする」をオン（既存プールは右クリックで有効化）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/manage-cool-access", "locator": "クール アクセス用に容量プールを構成する", "retrievedAt": "2026-10-15T17:10:00Z" }]
            },
            {
              "text": "ボリュームでクール アクセスと階層化ポリシー（Auto / SnapshotOnly）を設定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/manage-cool-access", "locator": "クール アクセス用にボリュームを構成する", "retrievedAt": "2026-10-15T17:10:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "自動 QoS が有効で、クール データが 100 GiB 超のボリュームが対象",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Premium および Ultra サービス レベルのスループット", "retrievedAt": "2026-10-15T17:10:00Z" }]
            },
            {
              "text": "容量プールのクール アクセス設定は、プール単位では無効に戻せない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/manage-cool-access", "locator": "クール アクセスが有効な容量プールについての考慮事項", "retrievedAt": "2026-10-15T17:10:00Z" }]
            }
          ]
        },
