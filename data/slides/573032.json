      "audience": {
        "who": { "text": "**Azure NetApp Files の Premium / Ultra** でクール アクセスを使う（使いたい）方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "ホット層の性能を保ちつつ、手動調整なしでクール アクセスの効果を得やすくなる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
