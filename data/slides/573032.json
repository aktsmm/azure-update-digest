              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/manage-cool-access", "locator": "クール アクセスの一般的な考慮事項", "retrievedAt": "2026-10-15T17:10:00Z" }]
            },
            {
              "text": "スループットは容量プール単位でなく、ボリューム単位で計算される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-netapp-files/cool-access-introduction", "locator": "Note", "retrievedAt": "2026-10-15T17:10:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "非アクティブなデータをクール層へ移してコストを抑える用途に向く",
