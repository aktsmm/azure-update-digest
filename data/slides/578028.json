      "speakerNotes": {
        "qa": [
          {
            "q": "自分の SQL Server は対象ですか？",
            "a": "SQL Server 2022 CU28 以降または 2025 CU11 以降の Enterprise / Developer が対象です。Standard と 2019 以前は対象外です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/managed-instance/managed-instance-link-extend-availability-group?view=azuresql" }]
          },
          {
            "q": "日本リージョンで使えますか？",
            "a": "Managed Instance リンク機能は、すべてのグローバル Azure リージョンで利用できると記載されています。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/managed-instance/managed-instance-link-feature-overview?view=azuresql" }]
          },
          {
            "q": "既存のシングルデータベース リンクはどうなりますか？",
            "a": "両モードは同一 SQL Server 上で共存できず、切り替えには既存リンクの削除とモード変更、リンクの再作成が必要です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/managed-instance/managed-instance-link-feature-overview?view=azuresql" }]
          }
        ]
