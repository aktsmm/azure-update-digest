          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "第 2 世代の Microsoft 設計 Arm64 プロセッサ Azure Cobalt 200 をサポート",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/overview",
                  "locator": "Cobalt 200 ARM SKU ファミリー",
                  "retrievedAt": "2026-11-19T00:15:00Z"
                }
              ]
            },
            {
              "text": "汎用は Dpsv7、メモリ最適化は Epsv7 の 2 ファミリ",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/overview",
                  "locator": "Cobalt 200 ARM SKU ファミリー",
                  "retrievedAt": "2026-11-19T00:15:00Z"
                }
              ]
            },
            {
              "text": "Cobalt 200 では 1 vCore が物理 CPU コア 1 つに相当",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute",
                  "locator": "コンピューティング レベル、仮想コア、サーバーの種類",
                  "retrievedAt": "2026-11-19T00:15:00Z"
                }
              ]
            }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "始め方",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "性能要件や価格性能目標に基づき、Cobalt 200 と x64 ベースから選択",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [
                {
                  "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/overview",
