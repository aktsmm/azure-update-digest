      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Azure VNet モードでは、プラットフォーム以外の送信トラフィックが VNet 内の委任サブネットを経由する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure VNet モードのしくみ", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "NSG ルール・ファイアウォール ポリシー・カスタム DNS・ネットワーク ログが適用される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure VNet モードのしくみ", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "ルートが許せば、ExpressRoute / VPN 経由のオンプレミスにも到達できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure VNet モードのしくみ", "retrievedAt": "2026-10-21T22:35:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "設定 → Workspace 構成 → Network で、エグレス モードに Azure VNet を選択",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure VNet モードを設定する", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "[サブネットを参照] で要件を満たすサブネットを選んで保存し、代表的なインシデントで動作を確認",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure VNet モードを設定する", "retrievedAt": "2026-10-21T22:35:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "専用サブネット（/27 以上、Microsoft.App/environments に委任、エージェントと同一リージョン）が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "サブネットの要件", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "制御対象は送信のみ。受信接続は非対応で、コネクタ通信は VNet を経由しない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "制限事項", "retrievedAt": "2026-10-21T22:35:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "ネットワーク制御モードの違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "無制限（既定）: 制限なし / 制限付き: URL 許可リストで制御 / Azure VNet: VNet 経由で制御",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "ネットワーク制御モード", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "Azure VNet は、監査やエグレス制御が必要な運用環境向けとして案内されている",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "ネットワーク制御モード", "retrievedAt": "2026-10-21T22:35:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "機微データを扱う本番環境で、インシデント調査時の送信通信を監査したい場合",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "ワークロードのネットワーク制御モードを選択する", "retrievedAt": "2026-10-21T22:35:00Z" }]
            },
            {
              "text": "パッケージ・コード リポジトリ・MCP は、切り替えか FQDN ルールで到達性を確保する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/sre-agent/network-integration", "locator": "Azure SRE エージェント インフラ ネットワーク", "retrievedAt": "2026-10-21T22:35:00Z" }]
            }
          ]
        }
