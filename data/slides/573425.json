          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "v1 と v2 の比較表", "retrievedAt": "2026-10-14T20:10:00Z" }]
        }
