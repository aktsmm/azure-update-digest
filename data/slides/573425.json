      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は flexible server と elastic cluster（v1 は flexible server のみ）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "v1 と v2 の比較表", "retrievedAt": "2026-10-14T20:10:00Z" }] },
            { "text": "Premium SSD v1 で最大 32 TB、Premium SSD v2 で最大 64 TB", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "v1 と v2 の比較表", "retrievedAt": "2026-10-14T20:10:00Z" }] },
            { "text": "日次・週次・オンデマンド。保持は 7 日〜10 年を独立ルールで設定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "柔軟なバックアップポリシー", "retrievedAt": "2026-10-14T20:10:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "v1 から v2 への移行は一方向。PostgreSQL 15 以降が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "v1エクスペリエンスからv2エクスペリエンスへの移行", "retrievedAt": "2026-10-14T20:10:00Z" }] },
            { "text": "Burstable 層は移行不可。汎用またはメモリ最適化へ変更が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "v1エクスペリエンスからv2エクスペリエンスへの移行", "retrievedAt": "2026-10-14T20:10:00Z" }] },
            { "text": "復元先は事前に作成が必要。数 TB では復元に数時間〜数日", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "復元フロー", "retrievedAt": "2026-10-14T20:10:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "保護機能: WORM 不変性、ソフト削除、マルチユーザー認証、CMK に対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-postgresql-flex-server-elastic-cluster-v2-overview", "locator": "主な機能", "retrievedAt": "2026-10-14T20:10:00Z" }] },
            { "text": "v1 の 1 TB 制限や週 1 回の頻度が課題なら、検証環境で v2 を試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
      ],
