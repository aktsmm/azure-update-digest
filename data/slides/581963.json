      },
      "beforeAfter": {
        "after": {
          "text": "Kubernetes のカスタム リソースで、AKS ワークロードの Azure Firewall 保護を管理できる",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "冒頭", "retrievedAt": "2026-11-22T23:35:00Z" }]
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure Firewall Controller が CRD を Azure Firewall の設定とポリシーに変換する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "冒頭", "retrievedAt": "2026-11-22T23:35:00Z" }] },
            { "text": "CRD は AzureFirewall / SecurityPolicy / SecurityPolicyAttachment の 3 種類", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "構成モデルを理解する", "retrievedAt": "2026-11-22T23:35:00Z" }] },
            { "text": "ポッド／名前空間セレクターに対応。IDPS・DNS・脅威インテリジェンス・SNAT も設定可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "構成モデルを理解する", "retrievedAt": "2026-11-22T23:35:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure CNI Overlay は非対応。仮想ネットワークのポッド IP を使う Azure CNI が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "Prerequisites", "retrievedAt": "2026-11-22T23:35:00Z" }] },
            { "text": "ポッドの送信のみ検査し、IPv4 のみ対応。1 クラスターにつきファイアウォール 1 つ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-22T23:35:00Z" }] },
            { "text": "Azure パブリック クラウドの、一覧にあるプレビュー リージョンのみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-22T23:35:00Z" }] }
          ]
        },
        { "id": "ga-timing", "heading": "GA の時期", "availability": "not-stated", "priority": "core" },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "既定は Premium SKU。既存の Standard SKU では IDPS・TLS 検査・URL フィルタリングは使えない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-22T23:35:00Z" }] },
            { "text": "ルート テーブルや送信タイプの変更は接続断の恐れがあるため、隔離した評価環境で試す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/deploy-firewall-for-containers", "locator": "Warning", "retrievedAt": "2026-11-22T23:35:00Z" }] }
          ]
        }
