        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "コントロール プレーンは Red Hat 所有の Azure アカウントでホストされ、ワーカー ノードのみ自分のサブスクリプションに配置", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/openshift/concepts-classic-hosted-control-planes-comparison", "locator": "アーキテクチャの概要", "retrievedAt": "2026-10-21T21:30:00Z" }] },
            { "text": "コントロール プレーンと各ノード プールを個別にアップグレード可能。クラスター作成は約 15～20 分", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/openshift/concepts-classic-hosted-control-planes-comparison", "locator": "主な違い", "retrievedAt": "2026-10-21T21:30:00Z" }] },
            { "text": "作成は Azure CLI、REST API、Bicep で実施。マネージド ID とワークロード ID に対応", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "プレビュー提供リージョンは 8 つ（UK South、East US 2、West Europe など）。日本リージョンは含まれない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/openshift/howto-choose-cluster-configuration", "locator": "Choose the cluster region", "retrievedAt": "2026-10-21T21:30:00Z" }] },
            { "text": "リージョンなどの設定は作成後に変更できず、変更には再作成が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/openshift/howto-choose-cluster-configuration", "locator": "冒頭 / Important", "retrievedAt": "2026-10-21T21:30:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ワーカー ノード 2 台から作成でき、課金はワーカー ノードのみ（標準は制御 3＋ワーカー 3 が必要）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/openshift/concepts-classic-hosted-control-planes-comparison", "locator": "最小コンピューティング フットプリント / 請求書", "retrievedAt": "2026-10-21T21:30:00Z" }] },
            { "text": "インフラストラクチャ ノードは使わず、イングレスや監視はワーカー ノードに配置される点を確認する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/openshift/concepts-classic-hosted-control-planes-comparison", "locator": "インフラストラクチャ ノード", "retrievedAt": "2026-10-21T21:30:00Z" }] }
