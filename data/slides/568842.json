            { "text": "Virtual Network Routing Appliance とユーザー定義ルートの構成が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "ExpressRoute およびVirtual Network Routing Appliance を使ったオンプレミス接続の設定", "retrievedAt": "2026-10-28T23:14:00Z" }] }
          ]
        },
        {
