      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対応サービス: Storage / SQL Database / Key Vault / Data Explorer", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "前提条件", "retrievedAt": "2026-10-28T23:14:00Z" }] },
