            { "text": "プライベート エンドポイント作成時に ip-version-type を IPv6 に設定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "プライベートエンドポイントの設定", "retrievedAt": "2026-10-28T23:14:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "前提・制約", "availability": "present", "priority": "core",
          "items": [
            { "text": "利用前にサブスクリプションでプレビュー機能の登録が必須", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "前提条件", "retrievedAt": "2026-10-28T23:14:00Z" }] },
            { "text": "提供リージョンは 5 つ（米国中西部・東アジア・英国南部・米国中部・北ヨーロッパ）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "前提条件", "retrievedAt": "2026-10-28T23:14:00Z" }] },
            { "text": "対象 PaaS はエンドポイントと同一リージョン。NSG / ASG は未対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/private-link/private-link-ipv6", "locator": "Limitations", "retrievedAt": "2026-10-28T23:14:00Z" }] }
