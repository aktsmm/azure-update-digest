        "who": { "text": "Foundry の**ホステッドエージェントの送信通信を制限したい**開発者・セキュリティ担当", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "外部アプライアンスなしで、エージェントの送信先をホスト単位で制御できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
