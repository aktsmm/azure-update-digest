        "summary": { "text": "評価向け。プレビューは本番・ライブ運用での利用を意図していない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "ネットワーク エグレス制御 (プレビュー)", "retrievedAt": "2026-10-15T18:50:00Z" }] }
      },
      "beforeAfter": {
        "after": { "text": "宛先ホストに基づく順序付きルールを RAI ポリシーに定義し、エージェントのサンドボックス内で送信前に適用できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "ルールは上から評価され、最初に一致したものが優先。ワイルドカード（*.contoso.com）も利用可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "エグレス ルールの評価方法", "retrievedAt": "2026-10-15T18:50:00Z" }] },
            { "text": "アクションは許可・拒否・変換（ヘッダー変更）・書き換え（宛先変更）の4種", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "エグレス ルールの評価方法", "retrievedAt": "2026-10-15T18:50:00Z" }] },
            { "text": "監査モードは拒否をログのみ、強制モードは拒否をブロック。決定は Application Insights に出力", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "強制モードを選択する / エグレスの決定を表示する", "retrievedAt": "2026-10-15T18:50:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "ホステッドエージェントのみ対象。プロンプト ベースのエージェントやモデルのデプロイには影響しない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "ネットワーク エグレス制御 (プレビュー)", "retrievedAt": "2026-10-15T18:50:00Z" }] },
            { "text": "ポリシーあたり最大 480 ルール。シークレット参照のヘッダー値は未対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "ルールの上限 / プレビューの制限事項と今後の予定", "retrievedAt": "2026-10-15T18:50:00Z" }] },
            { "text": "Azure Firewall などの代替ではなく補完。API バージョン 2026-05-15-preview で構成", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "プレビューの制限事項と今後の予定 / ネットワーク エグレス制御 (プレビュー)", "retrievedAt": "2026-10-15T18:50:00Z" }] }
          ]
        },
        { "id": "ga-timing", "heading": "GA の時期", "availability": "not-stated", "priority": "core" },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "まず監査モードと既定の拒否で通信先を洗い出し、ルール調整後に強制へ切り替える", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "強制モードを選択する / エグレス制御の一般的な使用用途", "retrievedAt": "2026-10-15T18:50:00Z" }] },
            { "text": "拒否されたリクエストにはエグレス プロキシが HTTP 403 を返す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/agents/how-to/add-hosted-agent-guardrails", "locator": "エグレスの決定を表示する", "retrievedAt": "2026-10-15T18:50:00Z" }] }
          ]
