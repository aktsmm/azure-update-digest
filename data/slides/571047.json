      "speakerNotes": {
        "qa": [
          {
            "q": "日本リージョンで使えますか？",
            "a": "elastic clusters はフレキシブル サーバーと同じリージョンで使え、同サービスは東日本・西日本で提供されています。",
            "evidence": [
              { "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/elastic-clusters/concepts-elastic-clusters-limitations", "locator": "Q: どのリージョンで使用できますか", "retrievedAt": "2026-10-16T06:55:00Z" },
              { "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/overview", "locator": "Azure リージョン", "retrievedAt": "2026-10-16T06:55:00Z" }
            ]
          },
          {
            "q": "既存クラスターを PostgreSQL 18 に上げられますか？",
            "a": "メジャー バージョン アップグレードは現在サポートされていません。移行には pg_dump / pg_restore や pgcopydb を使えます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/elastic-clusters/concepts-elastic-clusters-limitations", "locator": "全般 / Migrations", "retrievedAt": "2026-10-16T06:55:00Z" }]
          },
          {
            "q": "ノードは何台まで増やせますか？",
            "a": "Azure portal、CLI、IaC ツールで 20 ノードまでスケールアウトできます。ノード数の削減は現在サポートされていません。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/elastic-clusters/concepts-elastic-clusters-limitations", "locator": "全般", "retrievedAt": "2026-10-16T06:55:00Z" }]
          }
