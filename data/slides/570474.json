            { "text": "vHub: Route Server は関連付け済み。ポリシーで有効化するだけ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "vHub ファイアウォール", "retrievedAt": "2026-10-18T21:54:00Z" }] }
          ]
        },
        {
