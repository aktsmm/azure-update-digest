      "beforeAfter": {
        "before": {
          "text": "既定では、宛先がプライベート IP 範囲（RFC 1918 / RFC 6598）のとき、ネットワーク規則で SNAT されない",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "冒頭", "retrievedAt": "2026-10-18T21:54:00Z" }]
        },
        "after": {
          "text": "登録範囲とプライベート範囲を 30 分ごとに自動学習し、学習した宛先への通信は SNAT されない",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "自動学習SNATルート", "retrievedAt": "2026-10-18T21:54:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "登録範囲とプライベート範囲を 30 分ごとに自動学習する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "自動学習SNATルート", "retrievedAt": "2026-10-18T21:54:00Z" }] },
            { "text": "学習した範囲は内部として扱われ、その宛先への通信は SNAT されない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "自動学習SNATルート", "retrievedAt": "2026-10-18T21:54:00Z" }] },
            { "text": "VNet 展開とセキュア仮想ハブ（vHub）展開の両方に対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "自動学習SNATルート", "retrievedAt": "2026-10-18T21:54:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            { "text": "VNet: Route Server を同じ VNet に展開し、ファイアウォールに関連付ける", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/firewall/snat-private-range", "locator": "VNet ファイアウォール", "retrievedAt": "2026-10-18T21:54:00Z" }] },
