              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/dynamic-data-masking-regex?view=azuresql", "locator": "ステップ3", "retrievedAt": "2026-10-28T23:50:00Z" }]
