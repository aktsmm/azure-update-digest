        { "termKey": "blob-storage", "term": "Azure Blob Storage", "type": "product", "oneLine": { "text": "ユーザー委任 SAS に対応するストレージ サービス（Queue・Table・Files も対応）。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage/common/storage-sas-overview", "locator": "ユーザー委任 SAS", "retrievedAt": "2026-10-21T21:45:00Z" }] } },
