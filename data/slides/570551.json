      "beforeAfter": {
        "before": {
          "text": "既存のエフェメラル VM は部分キャッシュ モードで作成され、ベース ディスクは元のファイルの読み取りを行う",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "キャッシュ モード", "retrievedAt": "2026-10-18T21:05:00Z" }]
        },
        "after": {
          "text": "OS ディスク全体をローカルにキャッシュし、キャッシュ完了後はリモート ストレージの読み取りが不要になる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "VM 起動後にバックグラウンドで OS ディスクをキャッシュ。VM の作成時間には影響しない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "エフェメラル OS ディスクの完全キャッシュ モード", "retrievedAt": "2026-10-18T21:05:00Z" }]
            },
            {
              "text": "ストレージの中断中も OS ディスクを引き続き使用できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "エフェメラル OS ディスクの完全キャッシュ モード", "retrievedAt": "2026-10-18T21:05:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "テンプレートまたは REST API の diffDiskSettings で enableFullCaching を true に設定する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "完全キャッシュを有効にする方法", "retrievedAt": "2026-10-18T21:05:00Z" }]
            },
            {
              "text": "Azure CLI でも有効化できる",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "vCPU 8 以上の対応 VM シリーズ、API バージョン 2025-04-01 以降、OS ディスクはステートレス",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "完全キャッシュの前提条件", "retrievedAt": "2026-10-18T21:05:00Z" }]
            },
            {
              "text": "ローカル ストレージが OS ディスク サイズの 2 倍分減る（必要容量は 2 × OS ディスク + 1 GiB）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "サイズの要件", "retrievedAt": "2026-10-18T21:05:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "部分キャッシュ（既定）: 差分ディスクとベース ディスクで分割し、性能と効率のバランスを取る",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "キャッシュ モード", "retrievedAt": "2026-10-18T21:05:00Z" }]
            },
            {
              "text": "永続 OS ディスク: 書き込みデータは Azure Storage に保存される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/ephemeral-os-disks", "locator": "永続 OS ディスクとエフェメラル OS ディスクの違い", "retrievedAt": "2026-10-18T21:05:00Z" }]
            }
          ]
        },
        {
