        "who": { "text": "AKS で **Application Gateway for Containers** を使う／検討している方", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "各アプリで実装せず、ゲートウェイで JWT 検証を一元化できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "冒頭", "retrievedAt": "2026-11-04T23:10:00Z" }] },
