      },
      "beforeAfter": {
        "after": {
          "text": "AuthPolicy で署名・発行者・有効期限・オーディエンスを検証し、無効なリクエストはバックエンドへ転送されない",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "JWT検証が提供するもの", "retrievedAt": "2026-11-04T23:10:00Z" }]
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象: ApplicationLoadBalancer / Gateway / HTTPRoute / GRPCRoute / MCPRoute に AuthPolicy を接続", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "ポリシーのアタッチと継承", "retrievedAt": "2026-11-04T23:10:00Z" }] },
            { "text": "ポリシーは継承され、ルートで上書きや空の jwt ブロックによるオプトアウトが可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "ポリシーのアタッチと継承", "retrievedAt": "2026-11-04T23:10:00Z" }] },
            { "text": "OAuth 保護リソース メタデータ（RFC 9728）を任意で公開できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "OAuth保護リソースメタデータ", "retrievedAt": "2026-11-04T23:10:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "Gateway API のみ対応（Ingress API は非対応）。ポリシーと対象は同じ名前空間", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "Considerations", "retrievedAt": "2026-11-04T23:10:00Z" }] },
            { "text": "JWKS は HTTPS で、データ プレーンから名前解決・到達できる必要がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "Considerations", "retrievedAt": "2026-11-04T23:10:00Z" }] },
            { "text": "認可の判断はアプリ側。トークン発行やサインインは対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "JWT検証が提供するもの", "retrievedAt": "2026-11-04T23:10:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "WAF が先に評価され、通過後に JWT を検証。401 / 403 の原因切り分けに両ログを確認", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/jwt-validation", "locator": "WAFでのJWT検証の仕組み", "retrievedAt": "2026-11-04T23:10:00Z" }] },
            { "text": "検証環境で Entra ID などの発行者と JWKS を設定し、挙動を確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
      ],
