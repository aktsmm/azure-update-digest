            {
              "text": "Bastion のネイティブ クライアント トンネリングを使い、ローカルから AKS へ接続",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/bastion-connect-to-aks-private-cluster", "locator": "冒頭", "retrievedAt": "2026-10-21T22:20:00Z" }]
            },
            {
              "text": "クラスターのエンドポイントを公開せず、クライアントやエージェントの追加も不要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/bastion-connect-to-aks-private-cluster", "locator": "冒頭", "retrievedAt": "2026-10-21T22:20:00Z" }]
