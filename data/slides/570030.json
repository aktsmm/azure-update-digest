          "items": [
            {
              "text": "az login → az aks get-credentials --admin → az aks bastion でトンネルを開く",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/bastion-connect-to-aks-private-cluster", "locator": "接続する", "retrievedAt": "2026-10-21T22:20:00Z" }]
            },
            {
              "text": "一時 KUBECONFIG の server を Bastion トンネルのローカル ポートに向け、kubectl で操作",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/bastion/bastion-connect-to-aks-private-cluster", "locator": "接続する", "retrievedAt": "2026-10-21T22:20:00Z" }]
            }
          ]
        },
