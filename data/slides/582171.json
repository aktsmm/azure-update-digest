        "importance": "notable"
      },
      "audience": {
        "who": { "text": "Ultra disk を使う VM に **Azure Site Recovery でゾーン間 DR** を構成したい方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "高性能 VM でもゾーン障害に備えた復旧が可能になる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
