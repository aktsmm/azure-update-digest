      },
      "pricing": {
        "kind": "paid",
        "text": "ゾーン間 DR の料金は Azure 間 DR と同一。ゾーン間のデータ転送は別途課金",
        "origin": "learn", "assertion": "fact", "verification": "verified",
        "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "FAQs", "retrievedAt": "2026-11-26T01:35:00Z" }]
      },
      "beforeAfter": {
        "after": { "text": "Ultra disk を使う VM を、別の可用性ゾーンへレプリケートして復旧でき、ゾーン障害への耐障害性を高められる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "同一 Azure リージョン内の別ゾーンへ VM をレプリケートし、ゾーン障害時に復旧", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "データはリージョン外へ移動・保存されない（コンテナーにはメタデータのみ）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Supported regions", "retrievedAt": "2026-11-26T01:35:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            { "text": "ゾーン内の VM → [ディザスター リカバリー] →「可用性ゾーン間」で [はい] を選択", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Enable replication for the zonal Azure virtual machine", "retrievedAt": "2026-11-26T01:35:00Z" }] },
            { "text": "既定のまま、または詳細設定を調整し、[Start replication] を選択", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Enable replication for the zonal Azure virtual machine", "retrievedAt": "2026-11-26T01:35:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Ultra disk は高チャーン（High Churn）が必要。ホスト キャッシュは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-support-matrix", "locator": "Replicated machines - storage", "retrievedAt": "2026-11-26T01:35:00Z" }] },
            { "text": "保護の有効化・再同期の際はパブリック ネットワーク アクセスが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-support-matrix", "locator": "Replicated machines - storage", "retrievedAt": "2026-11-26T01:35:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ゾーン間 DR は同一リージョン内。リージョン全体の災害には不足する可能性がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Use availability zones for disaster recovery", "retrievedAt": "2026-11-26T01:35:00Z" }] },
            { "text": "ZRS のマネージド ディスクを持つ VM はゾーン間 DR 非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Supported regions", "retrievedAt": "2026-11-26T01:35:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "同一法域にペア リージョンがない場合や、ネットワークを再構築したくない場合に有効", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "Use availability zones for disaster recovery", "retrievedAt": "2026-11-26T01:35:00Z" }] },
            { "text": "フェールオーバー先のリソース グループは、ソースと別にする必要がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-zone-to-zone-disaster-recovery", "locator": "FAQs", "retrievedAt": "2026-11-26T01:35:00Z" }] }
          ]
        }
      ],
