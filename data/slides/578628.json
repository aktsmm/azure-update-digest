      "label": "GA",
      "title": {
        "ja": "Storage Actions に自動反映・実行停止・大文字小文字区別が追加",
        "subtitleJa": "タスク定義の更新が割り当てへ自動反映され、実行中の停止や _cs 演算子も使えます",
        "en": "Generally Available: Azure Storage Actions adds automatic task updates, execution controls, and case-sensitive matching"
      },
      "meta": {
        "publishedJst": "2026-11-03",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Azure Blob Storage", "Azure Data Lake Storage", "Azure Storage Actions"],
        "categories": ["storage", "databases"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "Blob Storage / Data Lake Storage で **Storage Actions のタスク**を運用している方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "割り当ての個別更新が不要になり、実行制御と条件指定の精度が上がる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "共有タスクを更新する前に、参照する割り当てを確認", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-assignment", "locator": "ストレージタスク定義の更新", "retrievedAt": "2026-11-05T00:22:00Z" }] }
      },
      "beforeAfter": {
        "after": {
          "text": "タスク定義の更新が既存の割り当てへ自動で適用され、各割り当てを個別に更新する必要がない",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "定義の更新は割り当てへ自動伝播し、スケジュール実行は次回から新定義を使用",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-assignment", "locator": "ストレージタスク定義の更新", "retrievedAt": "2026-11-05T00:22:00Z" }]
            },
            { "text": "実行中の割り当てを個別、またはタスク配下の全割り当てで停止要求できる（非同期処理）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "equals_cs / contains_cs / startsWith_cs / endsWith_cs / matches_cs を追加",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-conditions", "locator": "サポートされている演算子", "retrievedAt": "2026-11-05T00:22:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始め方", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "ストレージ タスクで条件と操作を定義し、ストレージ アカウントへ割り当てて実行する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/overview", "locator": "コンポーネント", "retrievedAt": "2026-11-05T00:22:00Z" }]
            },
            {
              "text": "既存の演算子は従来どおり大文字小文字を区別しない",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "キュー済み・進行中の実行は更新されず旧定義を使う。割り当ては汎用 v1 / レガシ Blob アカウントを対象にできない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [
                { "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-assignment", "locator": "ストレージタスク定義の更新", "retrievedAt": "2026-11-05T00:22:00Z" },
                { "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/overview", "locator": "実行", "retrievedAt": "2026-11-05T00:22:00Z" }
              ]
            },
            {
              "text": "matches / matches_cs は Metadata.Value と Tags.Value には使えない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-conditions", "locator": "サポートされている演算子", "retrievedAt": "2026-11-05T00:22:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "モック実行はデータを変更せず評価とレポートだけを行う。条件のプレビューは最大 5,000 件まで表示",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [
                { "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-assignment", "locator": "模擬実行", "retrievedAt": "2026-11-05T00:22:00Z" },
                { "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-conditions", "locator": "条件のプレビュー", "retrievedAt": "2026-11-05T00:22:00Z" }
              ]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "共有タスクの変更は複数アカウントに影響するため、更新前に割り当てを見直す",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-actions/storage-tasks/storage-task-assignment", "locator": "ストレージタスク定義の更新", "retrievedAt": "2026-11-05T00:22:00Z" }]
            },
            {
              "text": "拡張子など、大文字小文字で対象が変わる名前の条件で _cs 演算子を検討する",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            }
          ]
        }
      ],
