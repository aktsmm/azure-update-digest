            { "text": "Recovery Services コンテナーと Backup コンテナーに対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/cross-tenant-restore-overview", "locator": "冒頭", "retrievedAt": "2026-11-01T22:00:00Z" }] },
