      "speakerNotes": {
        "qa": [
          {
            "q": "日本リージョンで使えますか？",
            "a": "Recovery Services コンテナーはすべてのパブリック リージョンが対象です。Backup コンテナーは西ヨーロッパなど一部リージョンに限られます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/cross-tenant-restore-overview" }]
          },
          {
            "q": "元の場所へ復元できますか？",
            "a": "できません。代替場所への復元のみで、保管庫の復旧ポイントが対象です。スナップショットのみの復旧ポイントは対象外です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/cross-tenant-restore-overview" }]
          },
          {
            "q": "利用に必要な前提条件は？",
            "a": "ターゲット テナントのリソース ガードと所定の Azure ロールが必要です。ソースとターゲットのボールトは同じリージョンにある必要があります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/tutorial-cross-tenant-restore" }]
          }
        ]
      },
