      "title": {
        "ja": "Observability Agent が Basic / Auxiliary テーブルに対応（GA）",
        "subtitleJa": "低コストのテーブル プランに移した Log Analytics データも、エージェントの分析・調査で活用できます",
        "en": "Generally Available: Azure Copilot Observability Agent supports Basic and Auxiliary table plans"
      },
      "meta": {
        "publishedJst": "2026-09-02",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "August" }],
        "status": "Launched",
        "products": ["Azure Copilot", "Azure Monitor"],
        "categories": ["ai", "ops-governance", "devtools"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "**Azure Monitor Log Analytics と Observability Agent を使っている運用チーム**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "Basic / Auxiliary プランのデータもエージェントの分析対象になる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "no",
        "summary": { "text": "対象テーブルが既に Basic / Auxiliary なら追加設定は不要", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "対話型の分析と詳細な調査で、Basic / Auxiliary プランの Log Analytics データを扱える", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "メトリック・トレース・トポロジ・Azure リソースのコンテキストと併せて利用できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "エージェントは自然言語でログやメトリックを調べ、問題の調査を支援する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/aiops/observability-agent-overview", "locator": "冒頭", "retrievedAt": "2026-10-18T22:00:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始め方", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象テーブルが既に Basic / Auxiliary プランなら、追加の設定は不要", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "Application Insights または Log Analytics ワークスペースの [ログ] で [Observability Agent] を選びチャットを開始",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/aiops/observability-agent-chat", "locator": "[ログ] ページからチャットを開始する", "retrievedAt": "2026-10-18T22:00:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure Copilot へのアクセスが必要。会話は 24 時間まで、エージェントは英語のみ対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/aiops/observability-agent-overview", "locator": "現在の制限", "retrievedAt": "2026-10-18T22:00:00Z" }]
            },
            {
              "text": "Basic / Auxiliary プランは従来の価格レベルのワークスペースでは使えない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/logs/data-platform-logs", "locator": "テーブル プラン", "retrievedAt": "2026-10-18T22:00:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "テーブル プランの違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "テーブル プランは Analytics・Basic・Auxiliary の 3 種類。Basic / Auxiliary は対応テーブルのみ選択可",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/logs/data-platform-logs", "locator": "テーブル プラン", "retrievedAt": "2026-10-18T22:00:00Z" }]
            },
            {
              "text": "Basic / Auxiliary は Azure Monitor ダッシュボードに未対応（ワークブックと Grafana は対応）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-monitor/logs/data-platform-logs", "locator": "テーブル プラン（脚注）", "retrievedAt": "2026-10-18T22:00:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ", "availability": "present", "priority": "detail",
          "items": [
            { "text": "AKS の ContainerLogV2・監査ログ・コントロール プレーン ログなど大量ログを Basic 候補にしつつ調査に使う", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "コンテナーの stdout / stderr、監査証跡、ノードの syslog を低コスト プランへ移す", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        }
      ],
