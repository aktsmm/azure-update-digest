              "text": "OS SKU は Ubuntu2604。Kubernetes 1.36 以降のプレビューで利用可能",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-os-version", "locator": "OS SKU の表", "retrievedAt": "2026-10-14T21:44:00Z" }]
            },
            {
              "text": "AMD64 と Arm64 の最小ノード イメージを使用",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-os-version", "locator": "Ubuntu 26.04 への移行 (プレビュー)", "retrievedAt": "2026-10-14T21:44:00Z" }]
            },
            {
              "text": "対応する場合は Ubuntu 24.04 へロールバックも可能",
              "origin": "mrc",
              "assertion": "fact",
              "verification": "source-only"
            }
          ]
        },
