          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "Ubuntu2604Preview 機能フラグの登録が必要",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-os-version", "locator": "Ubuntu2604Preview フィーチャーフラグを登録する", "retrievedAt": "2026-10-14T21:44:00Z" }]
            },
            {
              "text": "第 2 世代 VM 対応の VM サイズが必要。FIPS・機密 VM・信頼された起動は非対応",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/upgrade-os-version", "locator": "Ubuntu 26.04 への移行 (プレビュー)", "retrievedAt": "2026-10-14T21:44:00Z" }]
            },
