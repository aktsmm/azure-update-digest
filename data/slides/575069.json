      "title": {
        "ja": "Azure HorizonDB でユーザー割り当てマネージド ID が GA に",
        "subtitleJa": "クラスターに Azure の ID を割り当てて一元管理し、認証情報の管理負担を減らせます",
        "en": "Generally Available: User-assigned managed identity for Azure HorizonDB"
      },
      "meta": {
        "publishedJst": "2026-11-18",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
