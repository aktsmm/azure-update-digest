        "change": { "text": "認証情報を管理する負担を減らし、より安全に連携できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "CMK や Entra 認証を使う場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": {
          "text": "HorizonDB クラスターに Azure の ID（UMI）を割り当てて一元管理でき、CMK や Microsoft Entra 認証など対応機能で利用できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "クラスターに割り当てた UMI で、CMK を Azure Key Vault から安全に取得",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "HorizonDB クラスターに割り当てられた ID", "retrievedAt": "2026-11-23T00:55:00Z" }]
            },
            {
              "text": "アプリは自身の UMI で、パスワードを保存せず HorizonDB に認証できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-overview", "locator": "アイデンティティとアクセス管理", "retrievedAt": "2026-11-23T00:55:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始め方", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "クラスターの作成時または既存クラスターの更新時に UMI を割り当てる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "ユーザー割り当てマネージド ID を既存のクラスターに割り当てる", "retrievedAt": "2026-11-23T00:55:00Z" }]
            },
            {
              "text": "既存クラスターは Portal の [データ暗号化] や CLI の cluster update で ID を変更可能",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-configure-data-encryption", "locator": "カスタマー マネージド キーの設定を更新する", "retrievedAt": "2026-11-23T00:55:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ID の割り当てだけでは Key Vault のキー アクセス権は付与されない。必要な権限を別途付与する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "Prerequisites", "retrievedAt": "2026-11-23T00:55:00Z" }]
            },
            {
              "text": "CMK に使用中の ID を削除するとクラスターにアクセスできなくなる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "既存のクラスターからユーザー割り当てマネージド ID を削除する", "retrievedAt": "2026-11-23T00:55:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "クラスターへ割り当てる ID は他の Azure リソースへのアクセス用、アプリ側の ID は HorizonDB への認証用",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "冒頭", "retrievedAt": "2026-11-23T00:55:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "パスワードを持たない接続や、CMK 運用の ID 管理を一元化したい場面で検討する",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            },
            {
              "text": "CMK でキー アクセスに使う ID は、削除前に別の ID を構成する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/horizondb/security/security-user-assigned-managed-identities", "locator": "既存のクラスターからユーザー割り当てマネージド ID を削除する", "retrievedAt": "2026-11-23T00:55:00Z" }]
            }
          ]
        }
