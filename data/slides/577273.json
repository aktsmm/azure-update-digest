        "qa": [
          {
            "q": "CYOT はいつから使えますか？",
            "a": "2026 年 10 月 30 日以降に構成エクスペリエンスが利用可能になります。それまでは構成できません。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/entra/identity/authentication/concept-phone-providers" }]
          },
          {
            "q": "対応しないとどうなりますか？",
            "a": "プロバイダーを構成せず SMS・音声が有効なままだと、廃止日以降は通常どおりサインインできなくなります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/entra/identity/authentication/concept-sms-voice-retirement" }]
          },
          {
            "q": "どのプロバイダーを選べますか？",
            "a": "初期は Soprano と Telesign で、一般提供に伴い増える予定です。Microsoft Security Store から選びます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/entra/identity/authentication/concept-phone-providers" }]
