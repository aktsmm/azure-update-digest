      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "SQL Server は Azure Local 上の Windows Server / Linux VM で実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "SQL Server on Azure Local overview", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "ワークロード・ローカル制御プレーン・管理データはオンプレミスに残る",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/deploy-disconnected?view=sql-server-ver17", "locator": "冒頭", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "導入の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "切断運用の Azure Local を展開 → VM を作成し SQL Server をインストール",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "How disconnected deployments work", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "ローカル ツールで管理・監視し、可用性・バックアップ・DR を設計",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "How disconnected deployments work", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure Arc の SQL Server 拡張機能は非対応（Azure 側の管理機能は使えない）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/deploy-disconnected?view=sql-server-ver17", "locator": "When to use disconnected operations", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "SQL Server ライセンスと切断運用プラットフォームのライセンスは別途必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/deploy-disconnected?view=sql-server-ver17", "locator": "Prerequisites", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "接続モードとの違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "接続モード: Azure Arc で一元的に管理 / 切断運用: Azure への継続接続は不要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "Deployment modes", "retrievedAt": "2026-10-14T22:30:00Z" }]
            },
            {
              "text": "切断運用の管理 Azure Local のバックアップは SQL Server を対象外（別途設定）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/sql/sql-server/azure-local/deploy-disconnected?view=sql-server-ver17", "locator": "Back up and recover SQL Server", "retrievedAt": "2026-10-14T22:30:00Z" }]
            }
          ]
        },
        {
