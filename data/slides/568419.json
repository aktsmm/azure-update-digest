      },
      "audience": {
        "who": { "text": "**PostgreSQL フレキシブル サーバーのメジャー バージョン アップグレードを予定している方**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "アップグレード前に阻害要因を特定でき、失敗や手戻りを減らせる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "アップグレード予定があれば、本番作業前に検証を実行", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": { "text": "検証はアップグレード実行中にインラインで行われていた", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "after": { "text": "検証だけを事前に独立して実行でき、問題を解消して再検証してから進められる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure のアップグレード ポリシーと pg_upgrade --check の要件で検証", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "検出例: 未対応の拡張機能、論理レプリケーション スロット、準備されたトランザクション", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "アップグレード検証チェック", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "バージョン変更・ダウンタイム・再起動は発生しない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "アップグレード検証チェック", "retrievedAt": "2026-10-29T15:40:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "実行方法", "availability": "present", "priority": "core",
          "items": [
            { "text": "portal: [アップグレード] → 対象バージョン → アクション [検証のみ] → [スタート]", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/how-to-run-upgrade-validation-checks", "locator": "ポータル", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "CLI: Azure CLI 2.89.0 以降で upgrade コマンドに --validate-only を指定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/how-to-run-upgrade-validation-checks", "locator": "CLI", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "結果は CSV でダウンロード可能。失敗時は修復ガイダンスを表示", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/how-to-run-upgrade-validation-checks", "locator": "検証結果を確認する", "retrievedAt": "2026-10-29T15:40:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "サーバー状態が「準備完了」で、他の操作が進行中でないこと", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "制限事項", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "読み取りレプリカは非対応。全データベースへの接続が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "制限事項", "retrievedAt": "2026-10-29T15:40:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "アップグレード本番との関係", "availability": "present", "priority": "detail",
          "items": [
            { "text": "同じ検証チェックは、メジャー バージョン アップグレード中にも自動実行される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "アップグレード検証チェック", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "検証では準備状況のみを確認し、実際のアップグレードは行わない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/how-to-run-upgrade-validation-checks", "locator": "Note", "retrievedAt": "2026-10-29T15:40:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "運用アップグレードの時間枠を決める前に実行する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "アップグレード検証チェック", "retrievedAt": "2026-10-29T15:40:00Z" }] },
            { "text": "ダウンタイムはないが、アクティビティが低い時間帯の実行を検討", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/concepts-major-version-upgrade", "locator": "制限事項", "retrievedAt": "2026-10-29T15:40:00Z" }] }
          ]
        }
      ],
      "glossary": [
