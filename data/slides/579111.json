          "items": [
            {
              "text": "VM の仮想ハード ディスクを Azure Storage アカウントへレプリケートして保護",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "Azure Site Recovery と Azure Local サービス", "retrievedAt": "2026-11-05T00:40:00Z" }]
            },
            {
              "text": "テスト フェールオーバーで、運用レプリケーションに影響なく計画を検証",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "テスト フェールオーバー", "retrievedAt": "2026-11-05T00:40:00Z" }]
            },
            {
              "text": "計画済み / 計画外の停止時に Azure へフェールオーバーし、準備後にフェールバック",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        },
