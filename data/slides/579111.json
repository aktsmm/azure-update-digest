              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "手順 1: インフラストラクチャを準備する", "retrievedAt": "2026-11-05T00:40:00Z" }]
            },
            {
              "text": "Recovery Services コンテナー、Hyper-V サイト、レプリケーション ポリシーを選択",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "手順 1: インフラストラクチャを準備する", "retrievedAt": "2026-11-05T00:40:00Z" }]
