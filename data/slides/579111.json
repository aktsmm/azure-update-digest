              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "手順 2: VM のレプリケーションを有効にする", "retrievedAt": "2026-11-05T00:40:00Z" }]
            }
          ]
        },
