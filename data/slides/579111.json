              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/site-recovery-overview", "locator": "レプリケートできるのは何ですか？", "retrievedAt": "2026-11-05T00:40:00Z" }]
            },
            {
              "text": "Azure Backup はデータを保護し復旧可能に保つ、別の BCDR サービス",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/site-recovery-overview", "locator": "Backup サービス", "retrievedAt": "2026-11-05T00:40:00Z" }]
