              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "前提条件と計画", "retrievedAt": "2026-11-05T00:40:00Z" }]
            },
            {
              "text": "コンテナーのオーナー権限と、Azure Local リソースの読み取り/書き込み権限が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-local/manage/azure-site-recovery", "locator": "前提条件と計画", "retrievedAt": "2026-11-05T00:40:00Z" }]
