      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "移行は 4 段階: ソース評価 → ターゲット選択 → データ移行 → 監視", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migrate-to-azure-sql-database?view=sql-server-ver17", "locator": "Azure SQL Databaseに移行する", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "移行方法は「DMS による移行 (プレビュー)」。ウィザードで統合ランタイムを設定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migrate-to-azure-sql-database?view=sql-server-ver17", "locator": "移行方法を選択してください", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "スキーマのみ・データのみ・両方を選択して移行できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migrate-to-azure-sql-database?view=sql-server-ver17", "locator": "移行するデータベーステーブルを選択します", "retrievedAt": "2026-10-14T23:11:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "オフライン移行のみ。オンライン移行は未対応で、開始時からダウンタイムが発生", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "Prerequisites の重要", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "オンライン状態のデータベースのみ移行可。空でない移行先テーブルは上書き", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migrate-to-azure-sql-database?view=sql-server-ver17", "locator": "ソースデータベースとターゲットデータベースを選択する", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "Azure Data Factory 用に作成した既存の SHIR は流用できない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "セルフホステッド統合ランタイムを構成する", "retrievedAt": "2026-10-14T23:11:00Z" }] }
          ]
        },
        {
          "id": "prerequisites", "heading": "前提条件", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Arc 対応 SQL Server と最新の Azure 拡張機能、移行先 Azure SQL Database", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "Prerequisites", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "Microsoft.DataMigration リソース プロバイダーの登録が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "Prerequisites", "retrievedAt": "2026-10-14T23:11:00Z" }] }
          ]
        },
        {
          "id": "permissions", "heading": "権限・ランタイム", "availability": "present", "priority": "detail",
          "items": [
            { "text": "移行先 DB の共同作成者ロールとリソース グループの閲覧者ロールが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "権限の構成", "retrievedAt": "2026-10-14T23:11:00Z" }] },
            { "text": "スキーマ移行には SHIR 5.37 以降を使用", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/migration-sql-database-prepare?view=sql-server-ver17", "locator": "セルフホステッド統合ランタイムを構成する", "retrievedAt": "2026-10-14T23:11:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
