        "qa": [
          {
            "q": "日本リージョンで使えますか？",
            "a": "リージョン一覧では、ローカル一時 SSD の v6 は Japan East で Intel / AMD、Japan West では AMD が掲載されています。",
            "evidence": [{ "url": "https://learn.microsoft.com/azure/postgresql/overview" }]
