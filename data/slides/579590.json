      },
      "beforeAfter": {
        "after": {
          "text": "Intel と AMD の v6 コンピュート（ローカル一時ディスク付き）が GA。高性能・大規模・価格性能比の向上を、従来の使い勝手のまま利用できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "v6 は汎用・メモリ最適化の両レベルで Intel / AMD を提供",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/postgresql/overview", "locator": "V6 SKU family (Generally Available)", "retrievedAt": "2026-11-19T00:02:00Z" }]
            },
            {
              "text": "ローカル一時 SSD 構成は、ソートや複雑なクエリなど一時領域を多く使う処理向け",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/postgresql/overview", "locator": "V6 SKU family (Generally Available)", "retrievedAt": "2026-11-19T00:02:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "選び方", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "サーバーの作成時、または [コンピューティングとストレージ] で v6 の SKU（例: D4ds_v6、D4ads_v6）を選択",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "料金 / 使用可能なサーバーの種類", "retrievedAt": "2026-11-19T00:02:00Z" }]
            },
            {
              "text": "コンピューティング レベル作成後も、仮想コア数は数秒で変更できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "冒頭", "retrievedAt": "2026-11-19T00:02:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "v6 から Burstable レベルへのスケールは未サポート。提供状況はリージョンと構成で異なる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/postgresql/overview", "locator": "V6 SKU family / Limitations", "retrievedAt": "2026-11-19T00:02:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ディスクレス v6（Dsv6 など）や Cobalt 200 にはローカル一時ストレージがない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/compute-storage/concepts-compute", "locator": "コンピューティング レベル、仮想コア、サーバーの種類", "retrievedAt": "2026-11-19T00:02:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "一時領域を多く使うソート・分析系の処理には、ローカル一時 SSD 構成が向く",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/postgresql/overview", "locator": "V6 SKU family (Generally Available)", "retrievedAt": "2026-11-19T00:02:00Z" }]
            },
            { "text": "SKU ごとの IOPS・帯域を確認して、ワークロードに合うサイズを選ぶ", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
