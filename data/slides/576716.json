              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/how-to-rotate-keys", "locator": "主キーを使用するときにキーをローテーションする", "retrievedAt": "2026-10-25T20:35:00Z" }]
