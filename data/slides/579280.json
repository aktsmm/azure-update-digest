      "title": {
        "ja": "Application Gateway の WAF Insights が一般提供（GA）に",
        "subtitleJa": "ログとメトリックを対話型ダッシュボードで確認、クエリなしで攻撃パターンや誤検知を調査できます",
        "en": "Generally Available: WAF Insights for Azure Application Gateway"
      },
      "meta": {
        "publishedJst": "2026-11-06",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Application Gateway", "Web Application Firewall"],
        "categories": ["networking", "security"],
        "importance": "high"
      },
      "audience": {
        "who": { "text": "**Application Gateway の WAF** を運用・監視しているセキュリティ / 運用担当の方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "クエリを書かずに、ブロックされた要求や誤検知を調査できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "WAF ログの調査を効率化したい場合に利用を検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "WAF ポリシーに組み込まれ、WAF のログとメトリックを 1 つのダッシュボードに集約", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Monitor タブで WAF の動向と上位ルールを把握し、Investigate タブで調査", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "ルールや URL から、該当する要求と一致した全ルールまで掘り下げられる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始めるには", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "WAF データの表示には、Application Gateway の診断設定を有効にする",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/insights", "locator": "前提条件", "retrievedAt": "2026-11-08T21:40:00Z" }]
            },
            {
              "text": "ダッシュボードは Azure Monitor ブックとして実装され、カスタマイズや拡張が可能",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/insights", "locator": "Azure ワークブック", "retrievedAt": "2026-11-08T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "診断ログがないとダッシュボードで WAF データを使えない。ログは取り込み遅延（通常 1〜5 分）が生じうる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/insights", "locator": "前提条件 / 制限事項と考慮事項", "retrievedAt": "2026-11-08T21:40:00Z" }]
            },
            { "text": "GA で Azure Diagnostics とリソース固有ログの両方に対応", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "メトリックは集計で異常検出向き、ログは要求ごとの詳細でフォレンジック調査向き",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/insights", "locator": "データ ソースとアーキテクチャ", "retrievedAt": "2026-11-08T21:40:00Z" }]
            },
            {
              "text": "Log Analytics で KQL を書く従来の方法に対し、クエリ不要で調査できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/log-analytics", "locator": "例でデータを調べる", "retrievedAt": "2026-11-08T21:40:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ノイズの多いルールを確認して誤検知を見つけ、WAF 構成の調整に役立てる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/insights", "locator": "ベスト プラクティス", "retrievedAt": "2026-11-08T21:40:00Z" }]
            },
            { "text": "GA で Triage タブは Investigate に名称変更。要求は最終的な WAF の結果で 1 回だけ集計", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        }
      ],
