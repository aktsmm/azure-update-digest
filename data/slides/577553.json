      },
      "audience": {
        "who": { "text": "PostgreSQL flexible server / Cosmos DB / Azure SQL のアプリに**キャッシュを追加したい方**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "キャッシュの定石・参照アーキテクチャ・手順付きチュートリアルが揃い、導入を進めやすい", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
