          "items": [
            { "text": "対象は Standard_NV4as_v4 から NV32ahs_v4 までの 8 サイズ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/lifecycle/retirement/nvv4-retirement", "locator": "冒頭", "retrievedAt": "2026-10-14T20:31:00Z" }] },
            { "text": "影響を受けるのは AMD Radeon Instinct MI25 GPU 搭載の NVv4 のみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/lifecycle/retirement/nvv4-retirement", "locator": "どのような影響を受けますか / Note", "retrievedAt": "2026-10-14T20:31:00Z" }] },
