      "beforeAfter": {
        "after": {
          "text": "Lasv5 は最大 30.7TB・読み取り 9.6M IOPS、Laosv5 は最大 138TB・読み取り 20.7M IOPS のローカル ストレージを利用できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
