      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み・主な仕様", "availability": "present", "priority": "core",
          "items": [
            { "text": "第 5 世代 AMD EPYC 9005（Turin）。2〜160 vCPU、vCPU あたり 8GiB", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "冒頭 / ホストの仕様", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "ローカル NVMe: Lasv5 は vCPU あたり 240GB、Laosv5 は 720GB", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/laosv5-series", "locator": "冒頭", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "最大ネットワーク帯域は 200Gbps（最大サイズ）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "Network タブ", "retrievedAt": "2026-10-15T16:35:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始めるには", "availability": "present", "priority": "core",
          "items": [
            { "text": "VM サイズに Standard_L*as_v5 / Standard_L*aos_v5 を選んで作成する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/laosv5-series", "locator": "シリーズにおけるサイズ", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "NVMe 対応の OS イメージが必要。非対応だとエラーになる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "機能のサポート（Note）", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "vCPU クォータを確認しておく", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "VM の基本リソース", "retrievedAt": "2026-10-15T16:35:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "第 2 世代 VM のみ。ライブ マイグレーション非対応、SCSI の一時ディスクなし", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "機能のサポート / テーブル定義", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "リモート ディスクは Standard SSD / HDD、Premium SSD。別課金", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "冒頭", "retrievedAt": "2026-10-15T16:35:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "前世代・似たシリーズとの違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Lasv4 比: 最大ローカル容量 33% 増、128 / 160 vCPU を追加", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Laosv4 比: 最大ローカル容量 500% 増、最大読み取り IOPS 619% 増", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Lasv5: Cassandra、MongoDB、Spark、Redis などのデータ集約型", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/lasv5-series", "locator": "冒頭", "retrievedAt": "2026-10-15T16:35:00Z" }] },
            { "text": "Laosv5: ストレージ キャッシュ、Elasticsearch、分散ファイル システム", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/sizes/storage-optimized/laosv5-series", "locator": "冒頭", "retrievedAt": "2026-10-15T16:35:00Z" }] }
          ]
        }
