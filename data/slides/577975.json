      "beforeAfter": {
        "before": { "text": "NAS の移行計画は、手作業のスプレッドシート中心だった", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "after": { "text": "アプライアンスが NAS を直接検出し、共有ごとの準備状況・Azure 構成・月額コストを評価できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "検出対象: Dell PowerScale（OneFS）/ NetApp ONTAP の SMB・NFS・S3 共有",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/add-server-credentials", "locator": "対応NASプラットフォーム", "retrievedAt": "2026-11-04T23:40:00Z" }]
            },
            {
              "text": "評価先: Azure Files / Azure Blob Storage / Azure NetApp Files",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/create-file-share-assessment", "locator": "ターゲットサービス", "retrievedAt": "2026-11-04T23:40:00Z" }]
            },
            {
              "text": "結果はビジネスケースやウェーブ計画にも利用できる",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        },
        {
          "id": "constraints", "heading": "前提・制約", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "アプライアンスに NAS クラスターの読み取り専用資格情報と検出ソースを追加する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/add-server-credentials", "locator": "NAS認証情報の追加", "retrievedAt": "2026-11-04T23:40:00Z" }]
            },
            {
              "text": "SAN / LUN は対象外。共有とシステムのメタデータのみ収集し、ファイル内容は読まない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/add-server-credentials", "locator": "対応NASプラットフォーム", "retrievedAt": "2026-11-04T23:40:00Z" }]
            },
            {
              "text": "Azure NetApp Files の推奨は NetApp 由来の共有のみ（PowerScale には出ない）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/create-file-share-assessment", "locator": "知っておくべきこと", "retrievedAt": "2026-11-04T23:40:00Z" }]
            }
          ]
        },
        {
          "id": "limits", "heading": "評価の仕組み・限界", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "評価単位は共有。サイズ基準は現状のオンプレミスか実績に基づく",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/create-file-share-assessment", "locator": "前提条件", "retrievedAt": "2026-11-04T23:40:00Z" }]
            },
            {
              "text": "Blob のサイズ設定は容量とアクセス頻度に基づき、性能検証はされない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/migrate/create-file-share-assessment", "locator": "知っておくべきこと", "retrievedAt": "2026-11-04T23:40:00Z" }]
            }
          ]
