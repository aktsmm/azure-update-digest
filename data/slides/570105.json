      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "イメージ構成を送信すると、サービスがビルド VM を用意してビルドし、配布する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "しくみ", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "ビルド基盤の構築・パッチ適用・運用は不要。同じテンプレート定義をクラウド間で使える", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "使い始めるには", "availability": "present", "priority": "core",
          "items": [
            { "text": "PowerShell・Azure CLI・ARM テンプレート・DevOps タスクのいずれかで構成を送信", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "しくみ", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "イメージ テンプレート リソースに対して Run を呼び出すとビルドが始まる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "しくみ", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "配布には、イメージの読み取り・書き込み権限を持つユーザー割り当て ID が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "アクセス許可", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "Windows Server 向け Azure ハイブリッド特典は未対応。イメージ テンプレートは移動不可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "コスト / 移動のサポート", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "配布先は Compute Gallery・マネージド イメージ・VHD。ギャラリーならバージョン管理も可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "特徴", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "パッチ済みソース イメージでゴールデン イメージを再構築し、コンプライアンスを維持", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "セキュリティ", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "ビルドではコンピューティング・ネットワーク・ストレージの費用が発生する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/image-builder-overview", "locator": "コスト", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        }
      ],
