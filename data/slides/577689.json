          ]
        },
        {
          "id": "impact-check", "heading": "影響・アクション", "availability": "present", "priority": "detail",
          "items": [
            { "text": "どちらかの _CL テーブルを参照していれば、Log Analytics 宛先を使用中", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "同 API を直接呼ぶアプリは、Logs Ingestion API への移行も必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/container-apps/migrate-logs-azure-monitor", "locator": "冒頭", "retrievedAt": "2026-11-01T21:56:00Z" }] }
          ]
        }
