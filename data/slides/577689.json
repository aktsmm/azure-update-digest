        "after": { "text": "Azure Monitor 宛先: 診断設定で選んだワークスペースの ContainerAppConsoleLogs / ContainerAppSystemLogs に書き込み", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/container-apps/migrate-logs-azure-monitor", "locator": "モニタリング移行の計画", "retrievedAt": "2026-11-01T21:56:00Z" }] }
      },
