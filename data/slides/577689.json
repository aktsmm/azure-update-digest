        {
          "id": "scope", "heading": "適用範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "ログ宛先が Log Analytics の Container Apps 環境が対象", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "背景: HTTP Data Collector API のサポートが 2026年9月14日に終了", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Express 環境モードは Azure Monitor 宛先が未提供のため、この移行の対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/container-apps/migrate-logs-azure-monitor", "locator": "Important", "retrievedAt": "2026-11-01T21:56:00Z" }] }
          ]
        },
        {
          "id": "permissions", "heading": "前提・知っておくべき点", "availability": "present", "priority": "core",
          "items": [
            { "text": "宛先を切り替えると、ルーティングは直ちに切り替わる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/container-apps/migrate-logs-azure-monitor", "locator": "モニタリング移行の計画", "retrievedAt": "2026-11-01T21:56:00Z" }] },
            { "text": "診断設定を作成するまでログは送信されず、反映に最大90分かかる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/container-apps/migrate-logs-azure-monitor", "locator": "モニタリング移行の計画", "retrievedAt": "2026-11-01T21:56:00Z" }] },
