        "who": { "text": "**Flex 従量課金プラン**でカスタム ドメインや証明書認証を使いたい Azure Functions 利用者", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "Flex 従量課金でもカスタム ドメイン・クライアント証明書認証・相互 TLS を構成できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
