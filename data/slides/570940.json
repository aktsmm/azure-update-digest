      },
      "beforeAfter": {
        "after": {
          "text": "関数アプリごとにプライベート証明書・パブリック証明書を各 3 つまで保持でき、プラットフォームとワーカー間の通信も暗号化できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "サイトスコープ: 証明書は同じ Web スペースで共有されず、各関数アプリに限定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト レベルの証明書を構成する", "retrievedAt": "2026-10-18T20:50:00Z" }]
            },
            {
              "text": "追加方法: .pfx / .cer のアップロード、Key Vault、App Service マネージド証明書",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト レベルの証明書を構成する", "retrievedAt": "2026-10-18T20:50:00Z" }]
            },
            {
              "text": "エンドツーエンド TLS: フロントエンドとワーカー間の通信を暗号化",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "エンドツーエンドのTLS暗号化を設定", "retrievedAt": "2026-10-18T20:50:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "ポータル: 関数アプリ → [設定] → [証明書] → [証明書の持ち込み (.pfx)] → [証明書の追加]",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "プライベート (.pfx) をアップロードする", "retrievedAt": "2026-10-18T20:50:00Z" }]
            },
            {
              "text": "E2E TLS: ARM / Bicep で endToEndEncryptionEnabled を true に設定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "エンドツーエンドのTLS暗号化を設定", "retrievedAt": "2026-10-18T20:50:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "既存アプリに移行手段はなく、新規の Flex 従量課金アプリが必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト単位の証明書に関する考慮事項", "retrievedAt": "2026-10-18T20:50:00Z" }]
            },
            {
              "text": "Azure CLI は未対応。ポータルか ARM / Bicep で管理。Linux 上のためファイル パスから読み込む",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト単位の証明書に関する考慮事項", "retrievedAt": "2026-10-18T20:50:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "証明書の種類と上限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "プライベート上限の対象: マネージド / App Service / Key Vault / .pfx（最大 3）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト レベルの証明書を構成する", "retrievedAt": "2026-10-18T20:50:00Z" }]
            },
            {
              "text": "パブリック証明書 (.cer) は別枠で最大 3。.pfx は中間・ルートを含める",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-functions/flex-consumption-how-to", "locator": "サイト単位の証明書に関する考慮事項", "retrievedAt": "2026-10-18T20:50:00Z" }]
            }
          ]
        },
