      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象: VM と統一 VMSS。Azure Linux / Ubuntu（カーネル 4.19 以降）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "Adaptive Shield に VM / VMSS を登録すると Neuron 拡張機能が自動導入される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/deploy-adaptive-shield-portal", "locator": "Neuron拡張機能を確認する", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "緩和策は手動承認か自動モードで適用でき、ロールバックも可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "主な利点", "retrievedAt": "2026-11-19T02:20:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "Windows、VMSS Flex、Kubernetes、コンテナは非対応。VM と VMSS の混在も不可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "1 サブスクリプション 2 シールド、1 シールドあたり最大 40 VM インスタンス", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "プレビューの制限事項", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "プレビュー機能の登録、マネージド ID、アウトバウンド接続が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/deploy-adaptive-shield-portal", "locator": "Prerequisites", "retrievedAt": "2026-11-19T02:20:00Z" }] }
          ]
        },
        {
          "id": "how-it-works", "heading": "保護の流れ", "availability": "present", "priority": "detail",
          "items": [
            { "text": "検出 → マッチ → 推奨 → 検証 → 適用 → 再検証の 6 段階を繰り返す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "どのように機能するのか", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "脆弱性を修復するものではなく、恒久対策までの一時的な保護層", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/overview", "locator": "主な利点", "retrievedAt": "2026-11-19T02:20:00Z" }] }
          ]
        },
        {
          "id": "setup", "heading": "導入手順", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ポータルで Adaptive Shield をデプロイし、重大度しきい値と対応戦略を設定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/deploy-adaptive-shield-portal", "locator": "適応シールドを作成する", "retrievedAt": "2026-11-19T02:20:00Z" }] },
            { "text": "Shield と保護対象リソースは同一リージョンに配置する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/adaptive-virtual-patching/deploy-adaptive-shield-portal", "locator": "Prerequisites", "retrievedAt": "2026-11-19T02:20:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "対象 OS・規模が自環境に合うか、テスト環境で緩和策の挙動を確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
