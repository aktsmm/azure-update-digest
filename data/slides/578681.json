      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "プロファイルごとに通常トラフィックをベースライン化し、急増時に攻撃元を選択的に緩和", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] },
            { "text": "2 段階設計: プロファイルのしきい値を超えた時だけ、クライアント別のしきい値を適用", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] },
            { "text": "各ルールに 3 段階の感度があり、推奨の既定は中感度", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方", "availability": "present", "priority": "core",
          "items": [
            { "text": "割り当てると、ルールは Log アクション・中感度で有効になる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] },
            { "text": "ログを確認し、アプリケーションに合わせて各ルールのアクションを設定する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] },
            { "text": "ヘルス プローブやロード テストは WAF 例外で対象から除外できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "信頼トラフィックをルールセットの適用対象から除外する", "retrievedAt": "2026-11-01T21:50:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "GA は 2 ルール（500100 / 500110）。geo ルール 2 件（500310 / 500320）はプレビュー", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "ルールセットの規則", "retrievedAt": "2026-11-01T21:50:00Z" }] },
            { "text": "過去 7 日の 50% 以上の日にトラフィックがないプロファイルは、ベースライン確立まで検出されない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ", "retrievedAt": "2026-11-01T21:50:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Allow のカスタム ルールでも本ルールセットは回避できない。除外には WAF 例外を使う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "HTTP DDoS ルールセットのしくみ（Important）", "retrievedAt": "2026-11-01T21:50:00Z" }] }
          ]
        },
        {
