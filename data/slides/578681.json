            { "text": "例外の範囲はできるだけ狭くする", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/afds/http-ddos-ruleset", "locator": "信頼トラフィックをルールセットの適用対象から除外する", "retrievedAt": "2026-11-01T21:50:00Z" }] }
