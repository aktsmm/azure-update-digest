      "title": {
        "ja": "Cosmos DB の「スループット バケット」が一般提供（GA）に",
        "subtitleJa": "同じコンテナーを共有するワークロードごとに、使える最大スループットを制限できます",
        "en": "Generally Available: Throughput buckets in Azure Cosmos DB"
      },
      "meta": {
        "publishedJst": "2026-11-18",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Azure Cosmos DB"],
        "categories": ["databases", "iot"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "同じコンテナーを複数のワークロードで共有する **Azure Cosmos DB の利用者**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "ワークロードごとの消費スループットに上限を設け、リソースの競合を抑えられる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "共有コンテナーで競合が起きている場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": { "text": "コンテナーを共有する複数ワークロードの消費スループットを、バケットごとの最大値で制限できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "バケットごとに最大スループットの割合を設定し、コンテナー全体に対する上限とする", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットのしくみ", "retrievedAt": "2026-11-19T00:30:00Z" }] },
            { "text": "上限を超えたバケットの要求は調整される。スループットはバケットに予約されず共有のまま", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットのしくみ", "retrievedAt": "2026-11-19T00:30:00Z" }] },
            { "text": "バケットに割り当てない要求は、制限なしでコンテナーのスループットを消費する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットのしくみ（注）", "retrievedAt": "2026-11-19T00:30:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            { "text": "データ エクスプローラー → コンテナーの [スケールと設定] → [スループット バケット] タブ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットの構成", "retrievedAt": "2026-11-19T00:30:00Z" }] },
            { "text": "バケットを「アクティブ」にし、最大スループットの割合を設定。要求側は SDK でバケット ID を指定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットの構成 / SDK 要求でのスループット バケットの使用", "retrievedAt": "2026-11-19T00:30:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "共有スループット データベース内のコンテナーとサーバーレス アカウントは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "制限事項", "retrievedAt": "2026-11-19T00:30:00Z" }] },
            { "text": "1 コンテナーあたり最大 5 バケット（ID 1〜5）。構成の変更は 10 分ごと", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets-faq", "locator": "よく寄せられる質問", "retrievedAt": "2026-11-19T00:30:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "関連する動作", "availability": "present", "priority": "detail",
          "items": [
            { "text": "上限超過の要求は HTTP 429（副状態 3212）。割り当てた要求はバースト容量を使えない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets-faq", "locator": "バケットが最大スループットを超えるとどうなりますか", "retrievedAt": "2026-11-19T00:30:00Z" }, { "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "制限事項", "retrievedAt": "2026-11-19T00:30:00Z" }] },
            { "text": "既定バケットを設定すると、バケット未指定の要求が自動でそのバケットに割り当てられる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "既定のスループット バケットの構成", "retrievedAt": "2026-11-19T00:30:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ISV のマルチテナント、ETL の一括実行、データ取り込み・移行、変更フィード処理で有用", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "使用状況は ThroughputBucket で分割したメトリックで監視できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/cosmos-db/throughput-buckets", "locator": "スループット バケットの監視", "retrievedAt": "2026-11-19T00:30:00Z" }] }
          ]
        }
