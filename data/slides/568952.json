        "subtitleJa": "Windows 固有の依存関係を保ったまま、コード変更を抑えて Web アプリを PaaS へ移行できます",
        "en": "Generally Available: Managed Instance on Azure App Service"
      },
      "meta": {
        "publishedJst": "2026-08-19",
        "modifiedJst": "2026-08-19",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "August" }],
