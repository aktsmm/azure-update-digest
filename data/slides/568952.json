        "importance": "notable"
      },
      "audience": {
        "who": { "text": "オンプレミスや VM 上の **Windows / .NET Framework の Web アプリを移行したい方**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "コード変更を抑え、Windows 依存を保ったまま App Service へ移行できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "移行候補の Windows Web アプリがあれば、対象リージョンと SKU を確認して評価", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": { "text": "Windows 固有の依存関係との互換性を保ったまま、フル マネージドな App Service 環境へ移行できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "プラン単位のホスティング。Windows の Web アプリ向けに OS のカスタマイズが可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "冒頭", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "起動時に実行する PowerShell 構成スクリプト、レジストリ アダプター、ストレージ マウントを提供", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "構成オプション", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "Azure Bastion 経由の Just-In-Time RDP で診断（仮想ネットワーク統合が必要）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "主な機能", "retrievedAt": "2026-10-29T00:00:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure Migrate で対象ワークロードを評価し、Azure portal / Azure CLI / IaC でデプロイ", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "portal で「Web App (Managed Instance)」を作成し、Pv4 / Pmv4 プランを選択", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/quickstart-managed-instance", "locator": "マネージド インスタンス プランをデプロイする", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "VS Code の GitHub Copilot モダナイゼーションで評価からデプロイまで支援", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "GitHub Copilot のモダナイゼーション", "retrievedAt": "2026-10-29T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Windows の Web アプリのみ。Pv4 / Pmv4 のみ。Linux・コンテナー・ASE は非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "現在の制限", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "認証は Entra ID とマネージド ID のみ（ドメイン参加 / NTLM / Kerberos なし）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "現在の制限", "retrievedAt": "2026-10-29T00:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似たホスティング オプションとの違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Standard App Service: Linux・コンテナー・多言語向けで OS カスタマイズなし", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "適切なホスティング オプションの選択", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "App Service Environment: 完全分離の専用基盤で 100 以上のアプリ規模", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "適切なホスティング オプションの選択", "retrievedAt": "2026-10-29T00:00:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "COM・レジストリ・MSI・GAC・MSMQ など、レガシー .NET Framework アプリの段階的な最新化", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "適切なホスティング オプションの選択", "retrievedAt": "2026-10-29T00:00:00Z" }] },
            { "text": "永続的な変更は構成スクリプトで行う。RDP での変更は再起動後に失われる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/app-service/overview-managed-instance", "locator": "構成オプション", "retrievedAt": "2026-10-29T00:00:00Z" }] }
          ]
        }
      ],
