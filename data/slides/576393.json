          "items": [
            { "text": "フロントエンドからパブリック IP を削除し、承認済みプライベート エンドポイントの接続だけを受け付ける", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/private-ingress", "locator": "冒頭", "retrievedAt": "2026-11-04T23:20:00Z" }] },
            { "text": "1 つのリソースで公開・非公開の両フロントエンドを持て、WAF ポリシーもフロントエンドごとに関連付け可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/private-ingress", "locator": "フロントエンドの型 / Web Application Firewall のサポート", "retrievedAt": "2026-11-04T23:20:00Z" }] },
