          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "条件: 2026/4/23 以降作成の関連付け、REST API 2026-03-01 以降、ALB コントローラー v1.13 以降", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/private-ingress", "locator": "Limitations", "retrievedAt": "2026-11-04T23:20:00Z" }] },
            { "text": "プレビュー中は az rest で作成が必要（az network alb frontend create は未対応）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/application-gateway/for-containers/how-to-private-ingress-gateway-api", "locator": "プライベートフロントエンドの設定", "retrievedAt": "2026-11-04T23:20:00Z" }] },
