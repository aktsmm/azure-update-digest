      "title": {
        "ja": "Azure Managed Redis のキースペース通知が一般提供（GA）に",
        "subtitleJa": "キャッシュ内のデータ変更を Pub/Sub のイベントとして受け取れます",
        "en": "Generally Available: Azure Managed Redis keyspace notifications "
      },
      "meta": {
        "publishedJst": "2026-11-18",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "November" }],
        "status": "Launched",
        "products": ["Azure Managed Redis"],
        "categories": ["databases"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "**Azure Managed Redis** で、キーの変更や有効期限切れに応じた処理を作りたい開発者", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "キャッシュを常時ポーリングせず、変更や期限切れを通知で受け取れる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "イベント駆動の処理が必要な場合に設定を検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": {
          "text": "キー変更・期限切れなどを Pub/Sub 経由のイベントで受け取れる。通知設定は要件の変化に合わせて更新できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "クライアントが Pub/Sub チャネルを購読し、Redis データ セットに影響するイベントを受信する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "冒頭", "retrievedAt": "2026-11-23T01:20:00Z" }]
            },
            {
              "text": "notifyKeyspaceEvents の値でイベント種別を指定。K または E が通知の受信に必須（KEA でほとんどのイベント）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "キースペース通知を有効にしてキャッシュをデプロイする", "retrievedAt": "2026-11-23T01:20:00Z" }]
            },
            {
              "text": "購読は全イベント・特定イベント種別・特定キーから選べる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "イベントを確認して購読する", "retrievedAt": "2026-11-23T01:20:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Azure portal: キャッシュ → [詳細設定] → キースペース通知を有効化 → イベント種別の文字列を入力 → [保存]",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "Azure ポータルでキースペース通知を有効にする", "retrievedAt": "2026-11-23T01:20:00Z" }]
            },
            {
              "text": "ARM テンプレート: databases の notifyKeyspaceEvents を設定して az deployment group create でデプロイ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "キースペース通知を有効にしてキャッシュをデプロイする", "retrievedAt": "2026-11-23T01:20:00Z" }]
            },
            {
              "text": "redis-cli などで 2 つのセッションを開き、購読側と操作側でイベントを確認",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "Redis クライアントの接続", "retrievedAt": "2026-11-23T01:20:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Redis Insight または redis-cli が必要。ARM テンプレートの理解も前提",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "Prerequisites", "retrievedAt": "2026-11-23T01:20:00Z" }]
            },
            {
              "text": "テンプレートで更新する際は、既存のキャッシュ設定を含めて他のプロパティの上書きを防ぐ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "通知設定を更新する", "retrievedAt": "2026-11-23T01:20:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "更新と変更", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "設定はキャッシュを再作成せず変更でき、データ損失なしで有効・無効・変更が可能（例: KEA から Ex）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/redis/enable-redis-keyspace-notifications", "locator": "通知設定を更新する", "retrievedAt": "2026-11-23T01:20:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "キー変更の監視、期限切れへの対応、後続処理の起動をポーリングなしで行う",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        }
      ],
