        { "termKey": "acl", "term": "ACL", "type": "term", "oneLine": { "text": "ディレクトリやファイル単位で、ユーザーごとのアクセス許可を定めるアクセス制御リスト。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/search/search-indexer-access-control-lists-and-role-based-access", "locator": "Support for the permission model", "retrievedAt": "2026-11-26T01:50:00Z" }] } },
        { "termKey": "rbac", "term": "RBAC", "type": "term", "oneLine": { "text": "ロールの割り当てでアクセスを制御する方式。ここではコンテナー単位の粗い制御。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/search/search-indexer-access-control-lists-and-role-based-access", "locator": "Support for the permission model", "retrievedAt": "2026-11-26T01:50:00Z" }] } },
