          "items": [
            { "text": "プライベート接続と Key Vault を用意でき、検証用の共有で初回コピーと差分コピーを試せるか確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        },
        {
          "id": "prerequisites", "heading": "前提", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Storage Mover リソース、ストレージ アカウントと Azure ファイル共有、SMB 認証情報用の Key Vault が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "前提条件", "retrievedAt": "2026-10-19T00:00:00Z" }] }
          ]
