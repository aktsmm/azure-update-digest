      "title": {
        "ja": "Storage Mover が SMB から Azure Files へエージェントレス移行（プレビュー）",
        "subtitleJa": "移行エージェントを展開せず、オンプレミスの SMB 共有を Azure Files へコピーできます",
        "en": "Public Preview: Agentless migration of on-premises SMB file shares to Azure Files (SMB)"
      },
      "meta": {
        "publishedJst": "2026-09-12",
        "availability": [{ "rawRing": "Preview", "year": 2026, "month": "September" }],
        "status": "In preview",
        "products": ["Azure Storage Mover"],
        "categories": ["storage"],
        "importance": "normal"
      },
      "audience": {
        "who": { "text": "Windows Server や NAS の **SMB ファイル共有を Azure Files へ移行する**方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "オンプレミスに移行エージェントを用意せずに移行できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "プレビューのため、まず検証用の共有で評価", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "移行の制限と動作", "retrievedAt": "2026-10-19T00:00:00Z" }] }
      },
      "beforeAfter": {
        "after": {
          "text": "移行エージェントの展開・登録・保守なしで、Storage Mover が既存のプライベート接続経由で SMB 共有に直接接続してコピーする",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "移行元: Windows Server / NAS の SMB 共有（SMB 2.x / 3.x）、移行先: Azure Files（SMB）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/service-overview", "locator": "サポートされているソースとターゲット", "retrievedAt": "2026-10-19T00:00:00Z" }] },
            { "text": "認証情報は Key Vault に保存し、マネージド ID でソースとターゲットにアクセス", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Azure portal または Azure CLI でエンドポイントとジョブを設定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "移行ジョブを作成して運用する", "retrievedAt": "2026-10-19T00:00:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "VPN や ExpressRoute などのプライベート接続が必須", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "Important", "retrievedAt": "2026-10-19T00:00:00Z" }] },
            { "text": "1 ジョブ最大 5 億オブジェクト、1 サブスクリプションで同時 10 ジョブ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "移行の制限と動作", "retrievedAt": "2026-10-19T00:00:00Z" }] },
            { "text": "SMB 1.x ソースは非対応。データはコピーされ、ソースには残る", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/agentless-on-premises-files-migration", "locator": "移行の制限と動作", "retrievedAt": "2026-10-19T00:00:00Z" }] }
          ]
        },
