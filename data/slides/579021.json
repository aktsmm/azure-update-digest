      "speakerNotes": {
        "qa": [
          {
            "q": "Geo-Replication と Geo-Disaster Recovery は併用できますか?",
            "a": "併用できません。Geo-Replication はデータも複製し、Geo-Disaster Recovery はメタデータのみを複製します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/service-bus-messaging/service-bus-geo-replication" }]
          },
          {
            "q": "セカンダリ リージョンはいくつ構成できますか?",
            "a": "現在サポートされているセカンダリ リージョンは 1 つだけです。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/service-bus-messaging/service-bus-geo-replication" }]
          },
          {
            "q": "既存の名前空間をパーティション分割に変更できますか?",
            "a": "既存の名前空間でパーティション分割の設定は変更できません。作成時にパーティション数を設定します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/service-bus-messaging/enable-partitions-premium" }]
          }
