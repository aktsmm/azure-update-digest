        "who": { "text": "1 つのサブスクリプションで **多数のストレージ アカウント** を管理している方", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "アカウントを複数サブスクリプションに分散する必要が減る", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
