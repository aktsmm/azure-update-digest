      },
      "beforeAfter": {
        "before": {
          "text": "既定では、サブスクリプションの標準エンドポイントでリージョンあたり最大 250 個のストレージ アカウントを作成できる",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage/common/storage-account-overview", "locator": "標準エンドポイント", "retrievedAt": "2026-10-29T00:00:00Z" }]
        },
        "after": {
          "text": "クォータ引き上げの要求により、リージョンごとに標準エンドポイントで最大 1,000 個まで作成できる",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/quotas/storage-account-quota-requests", "locator": "冒頭", "retrievedAt": "2026-10-29T00:00:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は標準エンドポイントのアカウント。既定 250 → 最大 1,000（リージョン・サブスクリプション単位）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "SRP の読み取り・書き込み・一覧操作は、承認済みの上限に合わせて自動でスケール", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "対象は SRP コントロール プレーンの管理操作で、データ プレーン操作は含まない", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "引き上げの要求手順", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure Portal、Azure CLI、Azure PowerShell から、サポート チケットなしで要求できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "Portal: [クォータ] → [ストレージ] → 対象リージョンの [調整の要求] で最大 1000 を入力して送信",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/quotas/storage-account-quota-requests", "locator": "ストレージ アカウントのクォータの引き上げを要求する", "retrievedAt": "2026-10-29T00:00:00Z" }]
            },
            {
              "text": "PowerShell: Update-AzQuota でリージョンごとに上限値を指定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/quotas/storage-account-quota-requests", "locator": "PowerShell タブ", "retrievedAt": "2026-10-29T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "要求には共同作成者ロール（またはそれを含むロール）が必要。処理には数分かかる場合がある",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/quotas/storage-account-quota-requests", "locator": "ストレージ アカウントのクォータの引き上げを要求する", "retrievedAt": "2026-10-29T00:00:00Z" }]
            },
            {
              "text": "SRP の管理操作には別の上限あり（書き込みは 1 秒あたり 10 または 1 時間あたり 1,200 など）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage/common/scalability-targets-resource-provider", "locator": "リソース プロバイダーのスケール ターゲット", "retrievedAt": "2026-10-29T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure DNS ゾーン エンドポイント（プレビュー）は最大 5,000 だが、2027 年 3 月に廃止予定。標準エンドポイントが推奨",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage/common/storage-account-overview", "locator": "ストレージ アカウント エンドポイント", "retrievedAt": "2026-10-29T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "1 つのサブスクリプションにアカウントを集約し、管理を簡素化したい場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            {
              "text": "現在のクォータは Portal の [クォータ] や Get-AzStorageUsage で確認できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/quotas/storage-account-quota-requests", "locator": "リージョンの現在のクォータを表示する", "retrievedAt": "2026-10-29T00:00:00Z" }]
            }
          ]
        }
