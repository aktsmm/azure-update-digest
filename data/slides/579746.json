        "change": { "text": "既存の IPv4 接続を変えずに、IPv6 ルートの交換を追加できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": {
          "text": "IPv6 が必要なら検討。有効化は元に戻せず、プレビュー アクセスが有効なサブスクリプションが必要",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "冒頭・Important", "retrievedAt": "2026-11-12T00:20:00Z" }]
        }
      },
