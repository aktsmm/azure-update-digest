        "subtitleJa": "ハイブリッド接続で IPv4 と IPv6 の両方のルートを交換できます",
        "en": "Public Preview: Azure Route Server dual-stack IPv4/IPv6 support"
      },
      "meta": {
        "publishedJst": "2026-11-11",
        "modifiedJst": "2026-11-11",
        "availability": [{ "rawRing": "Effective", "year": 2026, "month": "November" }],
