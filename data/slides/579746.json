          "items": [
            { "text": "IPv4/IPv6 デュアルスタック モードで、両方のアドレス ファミリーのルートを交換", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "ExpressRoute・VPN Gateway 接続と、ハブ／スポーク VNet 内の NVA 接続にルート マップを適用可能", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "既存の IPv4 専用接続は変更されない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "Prerequisites", "retrievedAt": "2026-11-12T00:20:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "RouteServerSubnet に IPv6 /64 プレフィックスが必要。IPv4/IPv6 デュアルスタックの VNet で利用",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "Prerequisites", "retrievedAt": "2026-11-12T00:20:00Z" }]
            },
            {
              "text": "提供リージョンは限定的（東アジア・韓国中部・インド中部など 11 リージョン）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "地域ごとの提供状況", "retrievedAt": "2026-11-12T00:20:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "RouteServerSubnet に IPv6 を追加 → Route Server の [構成] でデュアルスタック モードを有効化",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "デュアルスタックモードを有効にする", "retrievedAt": "2026-11-12T00:20:00Z" }]
            },
            {
              "text": "有効化は完了まで最大 40 分かかることがある",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "デュアルスタックモードを有効にする", "retrievedAt": "2026-11-12T00:20:00Z" }]
            }
          ]
        },
        {
          "id": "impact-check", "heading": "影響・アクション", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "既存の Route Server で有効化すると不可逆。戻すには削除して再作成が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "Important", "retrievedAt": "2026-11-12T00:20:00Z" }]
            },
            {
              "text": "ハブ・スポーク構成では、スポークのピアリングの再同期が必要になる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/route-server/enable-route-server-dual-stack", "locator": "デュアルスタックモードを有効にする", "retrievedAt": "2026-11-12T00:20:00Z" }]
            }
          ]
