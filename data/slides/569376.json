        "summary": { "text": "Azure Linux の環境差異に悩む場合に試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": {
          "text": "開発用ワークステーションにも Azure Linux を拡張し、本番に近い構成で動作検証や問題の再現ができる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "systemd サポート付きの Azure Linux ターミナル環境。Linux のコマンド ライン ツールを Windows 上で実行できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/windows-subsystem-for-linux-overview", "locator": "冒頭", "retrievedAt": "2026-10-25T21:44:00Z" }]
            },
            {
              "text": "対応アーキテクチャは x86_64 と arm64",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/windows-subsystem-for-linux-overview", "locator": "サポートされているアーキテクチャ", "retrievedAt": "2026-10-25T21:44:00Z" }]
            },
            {
              "text": "VS Code や Git でローカル開発し、VM・AKS・コンテナーなどへデプロイできる",
              "origin": "mrc", "assertion": "fact", "verification": "source-only"
            }
          ]
        },
        {
          "id": "constraints", "heading": "前提・制約", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Windows 10 (22H2) または Windows 11、WSL 2 の有効化、インターネット接続が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/get-started-windows-subsystem-for-linux", "locator": "前提条件", "retrievedAt": "2026-10-25T21:44:00Z" }]
            },
            {
              "text": "VM や Azure サブスクリプションは不要。管理者権限なしでインストールできる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/get-started-windows-subsystem-for-linux", "locator": "冒頭 / インストール", "retrievedAt": "2026-10-25T21:44:00Z" }]
            },
            {
              "text": "更新は、WSL ユーザーの報告した問題が生産性に影響する場合に必要に応じて提供",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/windows-subsystem-for-linux-overview", "locator": "リリースのテンポ", "retrievedAt": "2026-10-25T21:44:00Z" }]
            }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure Linux を本番で使うチームは、ローカルで問題を再現できるか試す",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            },
            {
              "text": "VS Code の WSL 拡張機能を使うと、VS Code から Azure Linux 内でツールとターミナルを実行できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-linux/windows-subsystem-for-linux-overview", "locator": "WSL での開発", "retrievedAt": "2026-10-25T21:44:00Z" }]
            }
          ]
