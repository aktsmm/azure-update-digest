        "who": { "text": "Windows 上で Linux 開発をする**開発者・Azure Linux 利用チーム**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "開発・テスト・本番で、Microsoft サポートの同じ Linux 基盤を使える", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
