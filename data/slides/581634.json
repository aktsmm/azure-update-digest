          "items": [
            { "text": "プレビュー中は LRS のみ。Business Critical は Direct Attach 接続のみ対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage/elastic-san/next-generation-create", "locator": "Limitations", "retrievedAt": "2026-11-19T01:00:00Z" }] },
