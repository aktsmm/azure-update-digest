      "audience": {
        "who": { "text": "SAN の移行（データセンター撤退・ハードウェア更新）や、**SAP HANA などの高 I/O ワークロード**を Azure で動かす利用者", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
