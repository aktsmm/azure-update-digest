          "text": "QoS 階層、シン プロビジョニング、オートスケール、クラッシュ整合性スナップショットを備え、最大 1 PiB・400 万 IOPS・160 GBps まで拡張できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "QoS 階層: Business Critical（最大 40 万 IOPS）/ General Purpose の Direct Attach・iSCSI（最大 8 万 IOPS）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
