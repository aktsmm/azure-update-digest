      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "SQL IaaS Agent 拡張機能が収集し、Microsoft 管理のパイプラインで処理・保存する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "パフォーマンスモニタリングの仕組み", "retrievedAt": "2026-10-14T20:25:00Z" }]
            },
            {
              "text": "可視化: リソース利用状況・ストレージ性能・アクティブ セッション・待機統計",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "冒頭", "retrievedAt": "2026-10-14T20:25:00Z" }]
            },
            {
              "text": "閲覧は Fabric Database Hub、詳細分析は Azure Data Explorer エンドポイントで KQL",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "パフォーマンスデータの閲覧およびクエリ", "retrievedAt": "2026-10-14T20:25:00Z" }]
            }
          ]
        },
        {
          "id": "constraints", "heading": "前提・制約", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "SQL Server 2016 以降。Enterprise / Standard が対象（Developer 等は接続データのみ）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "サポートされている構成", "retrievedAt": "2026-10-14T20:25:00Z" }]
            },
            {
              "text": "拡張機能 2.0.229.0 以降（フル管理モード）、システム割り当てマネージド ID が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "前提条件", "retrievedAt": "2026-10-14T20:25:00Z" }]
            },
            {
              "text": "Microsoft.AzureArcData の登録と、テレメトリ先への 443 ポート送信が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "前提条件", "retrievedAt": "2026-10-14T20:25:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-enable", "heading": "有効化の方法", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "拡張機能の設定に DatabaseWatcheronAzureVM フラグを追加（VM ごとに設定）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "パフォーマンスモニタリングの仕組み", "retrievedAt": "2026-10-14T20:25:00Z" }]
            },
            {
              "text": "拡張機能の設定は累積されないため、更新時は既存の設定も含める",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "Important", "retrievedAt": "2026-10-14T20:25:00Z" }]
            }
          ]
        },
        {
          "id": "access", "heading": "閲覧に必要な権限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ダッシュボードとクエリは Azure RBAC を適用。サブスクリプションの閲覧者以上が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "パフォーマンスデータの閲覧およびクエリ", "retrievedAt": "2026-10-14T20:25:00Z" }]
            }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure SQL Database・SQL Managed Instance・Azure 外の SQL Server は対象外",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/virtual-machines/windows/enable-performance-monitoring-sql-vm", "locator": "プラットフォームのサポート", "retrievedAt": "2026-10-14T20:25:00Z" }]
