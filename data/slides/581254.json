        "change": { "text": "新しい VM を作らず、既存の VM と ZRS ディスクを使って別ゾーンで復旧できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "冒頭", "retrievedAt": "2026-11-22T23:55:00Z" }] },
