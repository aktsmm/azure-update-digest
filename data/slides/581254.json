      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "利用者が開始するフェールオーバー。ゾーン配置を変更し、代わりの VM は作らない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "冒頭", "retrievedAt": "2026-11-22T23:55:00Z" }] },
            { "text": "ZRS ディスクにコミットされたデータの RPO はほぼゼロ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "冒頭", "retrievedAt": "2026-11-22T23:55:00Z" }] },
            { "text": "ターゲット ゾーンの VM サイズ対応と空き容量が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "ゾーン フェールオーバーのしくみ", "retrievedAt": "2026-11-22T23:55:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "OS・データの全ディスクが Premium SSD ZRS か Standard SSD ZRS であること", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "Requirements", "retrievedAt": "2026-11-22T23:55:00Z" }] },
            { "text": "VM スケール セット・Azure Site Recovery・オンデマンド容量予約は非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "Limitations", "retrievedAt": "2026-11-22T23:55:00Z" }] },
            { "text": "復旧中は VM が割り当て解除されダウンタイムが発生。自動ではない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "ゾーン フェールオーバーのしくみ", "retrievedAt": "2026-11-22T23:55:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ソース ゾーンが正常なうちに有効化する。LRS ディスクは ZRS への準備が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "ゾーン フェールオーバー用に VM を準備する", "retrievedAt": "2026-11-22T23:55:00Z" }] },
            { "text": "リージョン障害や複数ゾーンにまたがる障害には対応しない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/zone-resilience", "locator": "Limitations", "retrievedAt": "2026-11-22T23:55:00Z" }] }
          ]
        }
