      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "SQL Server は Azure Local 上の Windows Server / Linux VM で動作し、データはローカルに残る", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "Azure Local 上の SQL Server の概要", "retrievedAt": "2026-10-15T16:40:00Z" }] },
            { "text": "接続モードでは SQL Server を Azure Arc に接続し、Azure が管理機能を提供する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "接続モード", "retrievedAt": "2026-10-15T16:40:00Z" }] }
          ]
        },
        {
          "id": "how-to-start", "heading": "始め方", "availability": "present", "priority": "core",
          "items": [
            { "text": "Azure Local をデプロイ → VM 作成と SQL Server のインストール → Azure Arc に接続", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/deploy?view=sql-server-ver17", "locator": "デプロイのワークフロー", "retrievedAt": "2026-10-15T16:40:00Z" }] },
            { "text": "必要に応じて監視・ガバナンス・セキュリティ・ライセンスを設定する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "接続型展開の仕組み", "retrievedAt": "2026-10-15T16:40:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Azure Local 対応ハードウェア、Azure サブスクリプション、Azure との接続、SQL Server ライセンスが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/deploy?view=sql-server-ver17", "locator": "前提条件", "retrievedAt": "2026-10-15T16:40:00Z" }] },
            { "text": "Linux の従量課金は、パッシブ レプリカを自動検出せず全インスタンスをアクティブとして課金", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/deploy?view=sql-server-ver17", "locator": "Azure Arcを通じてライセンスを設定する", "retrievedAt": "2026-10-15T16:40:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "切断運用は Azure 接続なしで動作するが、Arc の SQL Server 拡張機能（インベントリ等）は使えない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "限定的なオペレーション", "retrievedAt": "2026-10-15T16:40:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ", "availability": "present", "priority": "detail",
          "items": [
            { "text": "データ レジデンシー対応、低遅延アプリ、既存 SQL Server をクラウド移行せず近代化", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/overview?view=sql-server-ver17", "locator": "Azure Local で SQL Server を使うタイミング", "retrievedAt": "2026-10-15T16:40:00Z" }] },
            { "text": "SQL Server 2025 からローカル モデルの推論エンドポイントを呼び出せる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-local/deploy?view=sql-server-ver17", "locator": "ローカルAIアプリケーションを構築する", "retrievedAt": "2026-10-15T16:40:00Z" }] }
          ]
        }
