              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/frontdoor/rule-set-batch", "locator": "ルールの宣言", "retrievedAt": "2026-10-25T22:10:00Z" }]
