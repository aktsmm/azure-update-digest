          "items": [
            {
              "text": "拡張ゾーンは Microsoft グローバル ネットワークの一部で、ユーザーの近くに置かれる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/overview", "locator": "冒頭", "retrievedAt": "2026-10-15T17:40:00Z" }]
            },
            {
              "text": "コントロール プレーンはリージョンに残り、データ プレーンを拡張ゾーンに配置",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/overview", "locator": "Azure Extended Zones のサービス提供", "retrievedAt": "2026-10-15T17:40:00Z" }]
            },
            {
              "text": "Azure portal などの Azure ツールでリソースを作成・管理できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/overview", "locator": "冒頭", "retrievedAt": "2026-10-15T17:40:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "利用の流れ", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "Microsoft.EdgeZones リソース プロバイダーをサブスクリプションに登録",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/request-access", "locator": "Microsoft.EdgeZones リソース プロバイダーのサブスクリプションを登録する", "retrievedAt": "2026-10-15T17:40:00Z" }]
            },
            {
              "text": "対象の拡張ゾーンへ登録し、状態が Registered になれば利用可能",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/request-access", "locator": "Azure 拡張ゾーンに登録する", "retrievedAt": "2026-10-15T17:40:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "既定では無効。サブスクリプション所有者が、課金対象アカウントで拡張ゾーンごとに登録が必要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/request-access", "locator": "冒頭 / 注", "retrievedAt": "2026-10-15T17:40:00Z" }]
            },
            {
              "text": "提供されるのは Azure サービスの一部のみ（親リージョンは全サービス利用可）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/faq", "locator": "すべての Azure サービスは Azure 拡張ゾーンで提供されていますか?", "retrievedAt": "2026-10-15T17:40:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "対応サービス・請求", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "VM・AKS・仮想ネットワーク・マネージド ディスクなどが利用可能（一部はプレビュー）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/overview", "locator": "サービス提供の表", "retrievedAt": "2026-10-15T17:40:00Z" }]
            },
            {
              "text": "請求は Azure の他の部分と同じ体験。予約や節約プランにも対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/extended-zones/faq", "locator": "課金・予約インスタンスと節約プラン", "retrievedAt": "2026-10-15T17:40:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "メディア編集のような低遅延の処理や、特定地域内にデータを収めたい用途",
              "origin": "learn", "assertion": "fact", "verification": "verified",
