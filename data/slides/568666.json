          "items": [
            { "text": "対象は ExpressRoute 仮想ネットワーク ゲートウェイ。Virtual WAN ゲートウェイは未サポート", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/expressroute/resiliency-model", "locator": "始める前の準備", "retrievedAt": "2026-10-25T22:32:57Z" }] },
            { "text": "マルチホーム: 異なる場所の回線 2 本以上、または Metro 回線に接続", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/expressroute/resiliency-model", "locator": "マルチホーム構成", "retrievedAt": "2026-10-25T22:32:57Z" }] },
