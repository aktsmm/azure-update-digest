            { "text": "マルチホームのゲートウェイ削除も、シングルホームへの変更後に行う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/expressroute/resiliency-model", "locator": "マルチホームおよび Metro ゲートウェイ", "retrievedAt": "2026-10-25T22:32:57Z" }] }
