            },
            {
              "text": "azd x init で作成し、azd x pack → azd x publish で登録して実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/azure-developer-cli/extensions/develop/quickstart-build-extension", "locator": "拡張機能を実行する", "retrievedAt": "2026-10-18T21:15:00Z" }]
            },
            {
              "text": "azd x watch で変更を自動的にビルド・インストール",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/azure-developer-cli/extensions/develop/quickstart-build-extension", "locator": "開発中の変更を監視する", "retrievedAt": "2026-10-18T21:15:00Z" }]
            }
          ]
