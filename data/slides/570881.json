              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/developer/azure-developer-cli/extensions/develop/quickstart-build-extension", "locator": "前提条件", "retrievedAt": "2026-10-18T21:15:00Z" }]
            },
