      "title": {
        "ja": "Application Gateway WAF のブロック応答をカスタマイズ可能に（GA）",
        "subtitleJa": "ブロック時のステータスコードと本文を、ポリシー単位で独自に定義できます",
        "en": "Generally Available: Custom block response code and body for Application Gateway WAF"
      },
      "meta": {
        "publishedJst": "2026-08-25",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "August" }],
        "status": "Launched",
        "products": ["Application Gateway", "Web Application Firewall"],
        "categories": ["networking", "security"],
        "importance": "high"
      },
      "audience": {
        "who": { "text": "Application Gateway の WAF を使っていて、**ブロック時の応答を変えたい方**", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "既定の 403 固定メッセージ以外を返せる（Front Door の WAF と同様）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "応答を変えたい場合のみ設定", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": {
          "text": "一致したルールでブロックすると、403 と「The request is blocked」を返す",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "冒頭", "retrievedAt": "2026-10-22T00:00:00Z" }]
        },
        "after": {
          "text": "ブロック時の応答ステータスコードと本文を独自に定義でき、全ブロック要求に同じ応答を返す",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "WAF がルール一致で要求をブロックした際の応答を、独自の状態コードとメッセージに置き換える", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "冒頭", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "ポリシー レベルの設定で、ブロックされた全要求に同じ応答を返す", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            { "text": "WAF ポリシー → [設定] → [ポリシー設定] → [カスタムレスポンス] でコードと本文を入力し、保存", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "カスタム応答状態コードとメッセージを構成する", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "Azure CLI や PowerShell でも設定できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "冒頭", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            { "text": "使える状態コード: 200・403・405・406・429・990〜999。本文は最大 32 KB", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "制限事項", "retrievedAt": "2026-10-22T00:00:00Z" }] },
            { "text": "1 ゲートウェイで最大 20 ポリシー。ARM API は base64、Application Gateway for Containers は非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code", "locator": "制限事項", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Front Door の WAF にも同様のカスタム応答がある。Front Door の対応コードは 200・403・405・406・429", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/web-application-firewall/afds/waf-front-door-policy-settings", "locator": "WAF response for blocked requests", "retrievedAt": "2026-10-22T00:00:00Z" }] }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ブロックされたことが分かる独自のメッセージや、運用に合う状態コードを返したい場合に検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
      ],
