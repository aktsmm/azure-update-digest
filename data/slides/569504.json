      "speakerNotes": {
        "qa": [
          {
            "q": "どのステータスコードを設定できますか？",
            "a": "200・403・405・406・429・990〜999 のいずれかです。本文は最大 32 KB です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code" }]
          },
          {
            "q": "どこで設定しますか？",
            "a": "Azure portal の WAF ポリシー「ポリシー設定」の「カスタムレスポンス」で設定します。CLI や PowerShell も使えます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code" }]
          },
          {
            "q": "Application Gateway for Containers でも使えますか？",
            "a": "使えません。カスタム ブロック応答の状態コードと本文は Application Gateway for Containers WAF では未対応です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/web-application-firewall/ag/configure-custom-response-code" }]
          }
        ]
