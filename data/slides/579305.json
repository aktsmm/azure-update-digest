      "speakerNotes": {
        "qa": [
          {
            "q": "ロックを有効にした後、元に戻せますか？",
            "a": "できません。ロックは恒久的で、無効化も PITR 保持期間の短縮もできず、延長のみ可能です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Important", "retrievedAt": "2026-11-09T00:00:00Z" }]
          },
          {
            "q": "Hyperscale や SQL MI の全インスタンスで使えますか？",
            "a": "Hyperscale は未対応です。SQL MI は更新ポリシーが「常に最新」または SQL Server 2025 のインスタンスが対象です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Limitations", "retrievedAt": "2026-11-09T00:00:00Z" }]
          },
          {
            "q": "追加費用はかかりますか？",
            "a": "既定の不変性は追加料金なしです。バックアップの保持とストレージには通常のサービス料金が適用されます。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "ロックを有効にする前に計画を立ててください", "retrievedAt": "2026-11-09T00:00:00Z" }]
          }
        ]
