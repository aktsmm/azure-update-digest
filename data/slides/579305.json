        "status": "In preview",
        "products": ["Azure SQL Database", "Azure SQL Managed Instance"],
        "categories": ["databases", "ops-governance"],
        "importance": "normal"
      },
      "audience": {
        "who": { "text": "35 日など長い PITR 保持を求める **Azure SQL Database / Managed Instance の利用者**（金融系など）", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "既定 7 日の不変性を、設定した PITR 保持期間（最大 35 日）まで延長してロックできる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "長い不変性が必要な場合のみ有効化。ロックは恒久的なので保持期間を事前に確認", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Important", "retrievedAt": "2026-11-05T00:00:00Z" }] }
      },
      "beforeAfter": {
        "before": { "text": "既定では直近 7 日分の PITR バックアップのみ不変。保持期間を長くしても不変性は 7 日を超えて広がらない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "保護オプションを比較してください", "retrievedAt": "2026-11-05T00:00:00Z" }] },
        "after": { "text": "ロックを有効にすると、不変性が設定した PITR 保持期間全体（例: 35 日）に適用される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "PITR保持期間の変更不可をロック", "retrievedAt": "2026-11-05T00:00:00Z" }] }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は Azure SQL Database と SQL Managed Instance の PITR（短期保持）バックアップ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "冒頭", "retrievedAt": "2026-11-05T00:00:00Z" }] },
            { "text": "ポータル・Azure CLI・PowerShell で有効化。ストレージ アカウントの管理は不要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "ロックされたイミュータブルを有効にする", "retrievedAt": "2026-11-05T00:00:00Z" }] },
            { "text": "ロック後は PITR 保持期間の延長のみ可能。短縮や解除は不可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "PITR保持期間の変更不可をロック", "retrievedAt": "2026-11-05T00:00:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "ロックは恒久的で、データベースの削除そのものは防げない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Important", "retrievedAt": "2026-11-05T00:00:00Z" }] },
            { "text": "Hyperscale は非対応。MI は Always-up-to-date / SQL Server 2025 更新ポリシーのみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Limitations", "retrievedAt": "2026-11-05T00:00:00Z" }] },
            { "text": "LTR 保持の設定やリソース削除の防止は行わない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "Limitations", "retrievedAt": "2026-11-05T00:00:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "要件に合う保持期間を決め、後で短縮しなくてよいか確認してから有効化する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            { "text": "既定の不変性は追加料金なし。バックアップの保持・ストレージは通常のサービス料金の対象", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "ロックを有効にする前に計画を立ててください", "retrievedAt": "2026-11-05T00:00:00Z" }] }
          ]
        }
      ],
      "glossary": [
        { "termKey": "pitr", "term": "PITR", "type": "term", "oneLine": { "text": "自動バックアップを使い、過去の任意の時点へデータベースを復元するポイントインタイム復元。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "冒頭", "retrievedAt": "2026-11-05T00:00:00Z" }] } },
        { "termKey": "immutability", "term": "バックアップの不変性", "type": "feature", "oneLine": { "text": "不変期間中は、バックアップの変更や削除ができないよう保護する仕組み。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "冒頭", "retrievedAt": "2026-11-05T00:00:00Z" }] } },
        { "termKey": "ltr", "term": "LTR（長期保持）", "type": "term", "oneLine": { "text": "PITR とは別に設定する長期保持バックアップ。今回のロックは対象外。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/automatic-backup-immutability?view=azuresql", "locator": "保護オプションを比較してください", "retrievedAt": "2026-11-05T00:00:00Z" }] } },
