          "items": [
            { "text": "AKS の Azure リージョン外にある容量を接続し、データ所在地の要件に対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/flex-nodes-for-aks-overview", "locator": "AKS リージョン外の容量", "retrievedAt": "2026-10-15T18:11:00Z" }] },
            { "text": "ラボやテスト環境の amd64／arm64 ホストを AKS ノードとして利用", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/flex-nodes-for-aks-overview", "locator": "ラボ環境とテスト環境", "retrievedAt": "2026-10-15T18:11:00Z" }] }
