            { "text": "認証は Arc マネージド ID、マネージド ID、サービス プリンシパルから選択", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/flex-nodes-for-aks-overview", "locator": "Flex ノードの認証オプション", "retrievedAt": "2026-10-15T18:11:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "プレビューは SLA の対象外で、運用環境での使用は想定されていない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/flex-nodes-for-aks-overview", "locator": "Important", "retrievedAt": "2026-10-15T18:11:00Z" }] },
