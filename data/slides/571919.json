            { "text": "外部ホスト側のネットワーク、ファイアウォール、DNS は利用者が構成・運用する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/plan-flex-nodes-deployment", "locator": "必要なネットワーク接続を計画する", "retrievedAt": "2026-10-15T18:11:00Z" }] }
          ]
        },
