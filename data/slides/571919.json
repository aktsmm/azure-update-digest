          "items": [
            { "text": "ユーザー管理の VM／ベア メタルを、AKS クラスターのノードとして追加できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/flex-nodes-for-aks-overview", "locator": "概要", "retrievedAt": "2026-10-15T18:11:00Z" }] },
