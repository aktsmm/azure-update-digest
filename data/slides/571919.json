          "items": [
            { "text": "ホストは Linux マシン。Azure CLI と Linux 互換の Bash 環境を用意する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/plan-flex-nodes-deployment", "locator": "始める前の準備", "retrievedAt": "2026-10-15T18:11:00Z" }] },
            { "text": "ホスト ID、AKS API アクセス、ノード間の接続方法を事前に決める", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/plan-flex-nodes-deployment", "locator": "デプロイの決定を行う", "retrievedAt": "2026-10-15T18:11:00Z" }] }
          ]
