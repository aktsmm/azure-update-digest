      "speakerNotes": {
        "qa": [
          {
            "q": "自分の環境は対象ですか？",
            "a": "Linux ノード上の AKS 1.35.0 以降が対象で、クラスターで OIDC 発行者の有効化が必要です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/azure-csi-files-storage-provision", "locator": "ワークロード ID を使用して Azure Files ストレージにアクセスする", "retrievedAt": "2026-10-21T22:00:00Z" }]
          },
          {
            "q": "ストレージ アカウント キーは必要ですか？",
            "a": "不要です。マネージド ID に Storage File Data SMB MI Admin ロールを付与し、ワークロード ID トークンでマウントします。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/azure-csi-files-storage-provision", "locator": "マネージド ID を作成または再利用し、必要なアクセス許可を付与する", "retrievedAt": "2026-10-21T22:00:00Z" }]
          },
          {
            "q": "動的 PV と静的 PV で設定は違いますか？",
            "a": "どちらも mountWithWorkloadIdentityToken を true にします。静的 PV はさらにストレージ アカウントで SMBOauth を有効化します。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/azure-csi-files-storage-provision", "locator": "動的な PV / 静的な PV", "retrievedAt": "2026-10-21T22:00:00Z" }]
          }
        ]
      }
    }
