      },
      "panels": [
        {
          "id": "scope", "heading": "拡張された内容", "availability": "present", "priority": "core",
          "items": [
            { "text": "テレメトリ エンドポイントで、Microsoft 管理の監視データを直接クエリできる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "Azure portal の組み込み体験は Grafana ダッシュボードを採用", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "自分の Grafana を同じエンドポイントに接続でき、Fabric Database Hub で横断表示も可能", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "constraints", "heading": "前提条件・制約", "availability": "present", "priority": "core",
          "items": [
            { "text": "Windows 上の SQL Server 2016 SP1 以降、Standard / Enterprise。2012 R2 以前は非対象", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/sql-monitoring?view=sql-server-ver17", "locator": "前提条件", "retrievedAt": "2026-10-14T21:30:00Z" }] },
            { "text": "ライセンスはソフトウェア アシュアランスか従量課金制。フェールオーバー クラスター インスタンスは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/sql/sql-server/azure-arc/sql-monitoring?view=sql-server-ver17", "locator": "前提条件・現在の制限", "retrievedAt": "2026-10-14T21:30:00Z" }] },
            { "text": "エンドポイントのクエリは Azure 商用クラウドのみ。仕様はプレビュー中に変わる可能性あり", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/fabric/database/hub/microsoft-sql-query-performance-monitoring-telemetry", "locator": "重要・前提条件", "retrievedAt": "2026-10-14T21:30:00Z" }] }
          ]
        },
