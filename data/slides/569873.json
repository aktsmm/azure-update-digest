        { "termKey": "iptables", "term": "iptables", "type": "term", "oneLine": { "text": "従来のホストでパケットを処理するルール機構で、ルール処理のオーバーヘッドが生じる。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "冒頭", "retrievedAt": "2026-10-21T22:55:00Z" }] } },
        { "termKey": "label-ga", "term": "GA（一般提供）", "type": "label", "oneLine": { "text": "機能が完全にリリースされ、本番利用でサポートされる段階。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/lifecycle/faq/azure-infrastructure", "locator": "General availability (GA)", "retrievedAt": "2026-10-21T22:55:00Z" }] } }
      ],
