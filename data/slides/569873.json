  "slides": [
    {
      "key": "569873",
      "kind": "ga",
      "kindSource": "ring",
      "label": "GA",
      "title": {
        "ja": "AKS の eBPF ホスト ルーティングが一般提供（GA）に",
        "subtitleJa": "iptables を経由せず Linux カーネル内で転送し、低遅延・高スループットを狙えます",
        "en": "Generally Available: eBPF host routing in Advanced Container Networking Services for AKS"
      },
      "meta": {
        "publishedJst": "2026-08-25",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "June" }],
        "status": "Launched",
        "products": ["Azure Kubernetes Service (AKS)"],
        "categories": ["compute", "containers"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "**Cilium 搭載 Azure CNI の AKS クラスター**で ACNS を使う／検討している方", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/aks/how-to-enable-ebpf-host-routing", "locator": "Requirements and parameters", "retrievedAt": "2026-10-21T22:55:00Z" }] },
        "change": { "text": "ポッド間通信の遅延短縮・スループット向上・CPU 使用率の軽減が期待できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "主な利点", "retrievedAt": "2026-10-21T22:55:00Z" }] },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "性能重視のワークロードがあれば検討。有効化はノード更新を伴う", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "before": {
          "text": "従来のホスト ルーティングでは、ホスト ネットワーク名前空間で iptables と netfilter のルール処理によるオーバーヘッドが発生する",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "冒頭", "retrievedAt": "2026-10-21T22:55:00Z" }]
        },
        "after": {
          "text": "ルーティングを eBPF プログラムで実装し、Cilium がホストの iptables をバイパス。ホップと処理レイヤーが減り、パケット配信が速くなる",
          "origin": "learn", "assertion": "fact", "verification": "verified",
          "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "冒頭", "retrievedAt": "2026-10-21T22:55:00Z" }]
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "パケット転送とルーティングの判断を eBPF で Linux カーネル内に移す", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            {
              "text": "Cilium が BPF ベースのマスカレードで SNAT を引き継ぐ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "eBPF ホスト ルーティングのコンポーネント", "retrievedAt": "2026-10-21T22:55:00Z" }]
            },
            {
              "text": "iptables blocker が、ホストへの iptables ルール追加を防ぐ",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "eBPF ホスト ルーティングのコンポーネント", "retrievedAt": "2026-10-21T22:55:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "有効化の流れ（Azure CLI）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "新規: az aks create に --enable-acns と --acns-datapath-acceleration-mode BpfVeth を指定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/aks/how-to-enable-ebpf-host-routing", "locator": "Enable Advanced Container Networking Services and eBPF Host Routing", "retrievedAt": "2026-10-21T22:55:00Z" }]
            },
            {
              "text": "既存: az aks update で同じフラグを指定。ノードはローリング更新される",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [
                { "url": "https://learn.microsoft.com/azure/aks/how-to-enable-ebpf-host-routing", "locator": "on an existing cluster", "retrievedAt": "2026-10-21T22:55:00Z" },
                { "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "考慮事項", "retrievedAt": "2026-10-21T22:55:00Z" }
              ]
            },
            {
              "text": "無効化は --acns-datapath-acceleration-mode None（他の ACNS 機能は維持）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/aks/how-to-enable-ebpf-host-routing", "locator": "Disable eBPF Host Routing", "retrievedAt": "2026-10-21T22:55:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Azure CLI 2.71.0 以降、Kubernetes 1.33 以降、Azure Linux 3.0 か Ubuntu 24.04",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/azure/aks/how-to-enable-ebpf-host-routing", "locator": "Requirements and parameters", "retrievedAt": "2026-10-21T22:55:00Z" }]
            },
            {
              "text": "Windows ノード、機密 VM、ポッド サンドボックス、静的エグレス ゲートウェイは非対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "制限事項", "retrievedAt": "2026-10-21T22:55:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "関連する ACNS の機能", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ACNS は「監視」「セキュリティ」「パフォーマンス」で構成。本機能はパフォーマンス側",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/advanced-container-networking-services-overview", "locator": "コンテナネットワークのパフォーマンス", "retrievedAt": "2026-10-21T22:55:00Z" }]
            },
            {
              "text": "ACNS は有料オファリング。価格は公式の価格ページで確認できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "Pricing", "retrievedAt": "2026-10-21T22:55:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "高スループットのマイクロサービス、リアルタイム サービス、AI/ML ワークロード",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "主な利点", "retrievedAt": "2026-10-21T22:55:00Z" }]
            },
            {
              "text": "ホストの iptables ルールはバイパスされる。依存するクラスターは事前に確認する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/container-network-performance-ebpf-host-routing", "locator": "考慮事項", "retrievedAt": "2026-10-21T22:55:00Z" }]
            }
          ]
        }
      ],
