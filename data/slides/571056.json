            { "text": "保持期間は 0〜7 日。0 日で無効。Azure ポータル・PowerShell・Azure CLI で構成・復元", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/deleted-logical-server-restore", "locator": "ソフト削除の保持期間を設定する", "retrievedAt": "2026-10-18T20:18:00Z" }] },
