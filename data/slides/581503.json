          "items": [
            { "text": "ポリシーは Unlocked（拡張・短縮・解除可）と Locked（拡張のみ）の 2 種類", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "不変ポリシーの種類", "retrievedAt": "2026-11-18T23:55:00Z" }] },
            { "text": "ディスク復元やリージョン間コピーは可能。ブロックされるのは削除のみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "許可された操作とブロックされた操作", "retrievedAt": "2026-11-18T23:55:00Z" }] },
            { "text": "Locked ポリシーは SEC 17a-4 などの保存要件を満たすと Cohasset が検証", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "規制に対するコンプライアンス", "retrievedAt": "2026-11-18T23:55:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "プレビュー中は PowerShell／REST API のみ。ポータルと CLI は GA で対応予定", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "Limitations", "retrievedAt": "2026-11-18T23:55:00Z" }] },
            { "text": "Locked は Azure を含め誰も短縮・削除できず、期間満了まで削除不可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "不変ポリシーの種類", "retrievedAt": "2026-11-18T23:55:00Z" }] },
            { "text": "設定は作成後のみ。最大保持期間は 90 日。コピーはポリシーを継承しない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/virtual-machines/snapshot-configure-immutability", "locator": "Limitations", "retrievedAt": "2026-11-18T23:55:00Z" }] }
          ]
