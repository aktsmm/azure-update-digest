        "qa": [
          {
            "q": "対象のディスクとセクターサイズは？",
            "a": "Premium SSD v2 と Ultra ディスクで、512 バイトと 4KB の論理セクター サイズの両方に対応しています。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "対応ディスクとリカバリー範囲", "retrievedAt": "2026-10-25T20:20:00Z" }]
          },
          {
            "q": "どのような VM が対象ですか？",
            "a": "Ubuntu、RHEL、Debian、Oracle Linux、SLES、openSUSE を実行する Linux VM と Windows VM が対象です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "対応ディスクとリカバリー範囲", "retrievedAt": "2026-10-25T20:20:00Z" }]
          },
          {
            "q": "バックアップのポリシーに条件はありますか？",
