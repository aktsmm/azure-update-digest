      "audience": {
        "who": { "text": "Premium SSD v2 / Ultra ディスクの **Azure VM を Azure Backup で保護している方**", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "少量のファイルのために VM 全体を復元せずに済む", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "no",
