      },
      "beforeAfter": {
        "after": {
          "text": "Premium SSD v2 / Ultra ディスク（512 バイト・4KB セクター）の VM でも、個別のファイルやフォルダーを回復できる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            { "text": "ポータル / CLI / PowerShell でファイル回復用の実行ファイルまたはスクリプトを生成", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "対応するマシンで実行して復旧ポイントを参照し、必要なものだけコピー", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "ディスクや VM 全体の復元は不要。従来の ILR と同等の動作", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "VM → [バックアップ] → [ファイルの回復] → 復元ポイントを選択",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "手順1", "retrievedAt": "2026-10-25T20:20:00Z" }]
            },
            {
              "text": "Windows は実行可能ファイル、Linux は Python スクリプトをダウンロード",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "手順1", "retrievedAt": "2026-10-25T20:20:00Z" }]
            },
            {
              "text": "パスワード保護されているため、画面のパスワードをコピーして実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "手順1", "retrievedAt": "2026-10-25T20:20:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "Premium SSD v2 / Ultra ディスクの保護は Enhanced ポリシーが前提",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/backup/backup-support-matrix-iaas", "locator": "VM storage support", "retrievedAt": "2026-10-25T20:20:00Z" }]
            },
            {
              "text": "回復サイズは 10 GB 以下が目安（転送速度は約 1 GB/時）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "重要", "retrievedAt": "2026-10-25T20:20:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ILR: 個別のファイルやフォルダーを回復 / VM・ディスクの復元: 全体を復元",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "冒頭", "retrievedAt": "2026-10-25T20:20:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "誤って削除したファイルなど、少量のデータだけ戻したいときに検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            {
              "text": "ディスク種別が混在する VM でも、対象ディスクをすべて公開して回復できる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/backup/backup-azure-restore-files-from-vm", "locator": "対応ディスクとリカバリー範囲", "retrievedAt": "2026-10-25T20:20:00Z" }]
