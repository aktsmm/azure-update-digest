              "text": "エージェントとそのバージョンはそのまま残り、有効化で再びオンラインに",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/control-plane/govern-agent-infrastructure-entra-admin", "locator": "Disable と Enable", "retrievedAt": "2026-10-15T18:50:00Z" }]
