            { "text": "Pod マニフェストで runtimeClassName: kata-vm-isolation-v2 を指定して使う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/aks/use-pod-sandboxing", "locator": "概要", "retrievedAt": "2026-11-19T00:57:00Z" }] },
