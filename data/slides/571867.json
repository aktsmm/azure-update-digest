        "who": { "text": "Azure SQL Database の**単一データベース**を運用・監視している方", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "サポートされる構成", "retrievedAt": "2026-10-14T21:24:00Z" }] },
        "change": { "text": "監視エージェントやデータストアを構築せずに、性能の傾向とボトルネックを把握できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Introduction", "retrievedAt": "2026-10-14T21:24:00Z" }] },
