      },
      "action": {
        "required": "optional",
        "summary": { "text": "プレビューのため、まず対象データベースで有効化して評価する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "beforeAfter": {
        "after": { "text": "データベース単位で有効化すると、Azure が性能データを収集し、ダッシュボードや KQL で分析できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "How performance monitoring works", "retrievedAt": "2026-10-14T21:24:00Z" }] }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "DTU・vCore（2 vCore 以上）・サーバーレスの単一データベースが対象", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Supported configurations", "retrievedAt": "2026-10-14T21:24:00Z" }] },
            { "text": "データベースの拡張プロパティを true に設定して有効化する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Enable performance monitoring collection", "retrievedAt": "2026-10-14T21:24:00Z" }] },
            { "text": "有効化から通常 10 分以内にデータをクエリ可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Enable performance monitoring collection", "retrievedAt": "2026-10-14T21:24:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "エラスティック プールのデータベースとセカンダリ レプリカは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Supported configurations", "retrievedAt": "2026-10-14T21:24:00Z" }] },
            { "text": "有効化は db_owner 相当の権限が必要。閲覧・クエリは Reader 以上が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Prerequisites / Access prerequisites", "retrievedAt": "2026-10-14T21:24:00Z" }] },
            { "text": "Managed Instance や SQL Server 等では、このプロパティでは有効化されない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Platform support", "retrievedAt": "2026-10-14T21:24:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Fabric Database Hub のダッシュボードで、複数データベースの状況を横断して確認できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "View performance data in Fabric Database Hub", "retrievedAt": "2026-10-14T21:24:00Z" }] },
            { "text": "Azure Data Explorer の Web UI から KQL で独自に分析できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/azure/azure-sql/database/enable-performance-monitoring-sql-database?view=azuresql", "locator": "Query performance data with Azure Data Explorer", "retrievedAt": "2026-10-14T21:24:00Z" }] }
          ]
        }
