      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "SMB 共有を別アカウント・サブスクリプション・リージョンへコピー（同一 Entra テナント）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "1 回限り・スケジュール・定期の増分ジョブ。プレビューは Azure portal のみ", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "前提条件 / ジョブ スケジュール", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "コピー モードは、ファイル データと ACL・タイムスタンプなどに適用", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "ジョブ定義の作成", "retrievedAt": "2026-10-16T06:30:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "前提・制約", "availability": "present", "priority": "core",
          "items": [
            { "text": "プレビューのアクセスはサブスクリプション単位。サインアップが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "冒頭の Note", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "NFS は非対応。プレビューは SSD プロビジョニング v2 共有を使用", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "共有全体が対象でサブディレクトリは指定不可。同時ジョブは 10 件まで", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }] }
          ]
        },
        {
          "id": "use-cases", "heading": "主な使いどころ", "availability": "present", "priority": "detail",
          "items": [
            { "text": "ペア リージョン以外も選べる DR、リージョン移行、共有の統合", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "ユース ケース", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "RPO 保証はなく、復旧ポイントは最後に成功した実行の完了時点", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "ユース ケース / Note", "retrievedAt": "2026-10-16T06:30:00Z" }] }
          ]
        },
        {
          "id": "operations", "heading": "運用上の注意", "availability": "present", "priority": "detail",
          "items": [
            { "text": "実行ごとにソースの共有スナップショットからコピー（残れば手動削除）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }] },
            { "text": "スケジュール有効中はターゲットを変更しない（競合解決なし）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "共有の種類（SSD v2 か）と DR 要件（RPO 保証なし）を確認し、検証環境で試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
