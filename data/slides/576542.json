      "speakerNotes": {
        "qa": [
          {
            "q": "どんな共有が対象ですか？",
            "a": "SMB の Azure ファイル共有が対象で、NFS は非対応です。プレビューでは両側とも SSD プロビジョニング v2 共有の利用が案内されています。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }]
          },
          {
            "q": "別テナントの共有へコピーできますか？",
            "a": "ソースとターゲットは同じ Microsoft Entra テナント内である必要があります。サブスクリプションやリージョンは異なっても構いません。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "制限", "retrievedAt": "2026-10-16T06:30:00Z" }]
          },
          {
            "q": "災害対策（DR）に使えますか？",
            "a": "ペア リージョン以外も含む任意のリージョンにセカンダリ コピーを保持できますが、RPO の保証はありません。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "ユース ケース", "retrievedAt": "2026-10-16T06:30:00Z" }]
          },
          {
            "q": "日本リージョンの Storage Mover で使えますか？",
            "a": "Storage Mover を利用できる 6 リージョンに日本は含まれません。コピー対象の共有は別リージョンにあっても構いません。",
            "evidence": [{ "url": "https://learn.microsoft.com/azure/storage-mover/azure-files-to-azure-files-copy", "locator": "前提条件", "retrievedAt": "2026-10-16T06:30:00Z" }]
