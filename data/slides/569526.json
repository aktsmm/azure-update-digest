        "qa": [
          {
            "q": "延長サポートを使わずに済みますか？",
            "a": "できません。サポート外バージョンの対象サーバーは自動登録されます。対応バージョンへ上げると課金は止まります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/extended-support", "locator": "よく寄せられる質問 (FAQ)", "retrievedAt": "2026-10-21T22:50:00Z" }]
          },
          {
            "q": "いつから課金されますか？",
            "a": "PostgreSQL 11〜13 は 2026-08-01 に登録され、1 か月の猶予後、2026-09-01 に課金が始まります。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/extended-support", "locator": "登録と価格", "retrievedAt": "2026-10-21T22:50:00Z" }]
          },
          {
            "q": "停止中のサーバーにも課金されますか？",
            "a": "いいえ。課金は成功（実行中）状態のサーバーのみです。停止・削除・プロビジョニング失敗中は対象外です。",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/postgresql/configure-maintain/extended-support", "locator": "よく寄せられる質問 (FAQ)", "retrievedAt": "2026-10-21T22:50:00Z" }]
