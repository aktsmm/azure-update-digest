      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "非アクティブ時に自動一時停止し、アクティビティが戻ると自動再開する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-overview?view=azuresql", "locator": "冒頭", "retrievedAt": "2026-10-14T22:50:00Z" }] },
            { "text": "一時停止中はコンピューティング コストがゼロで、ストレージ コストのみ発生する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-overview?view=azuresql", "locator": "コスト", "retrievedAt": "2026-10-14T22:50:00Z" }] },
            { "text": "一時停止の条件は、遅延期間中にセッション数 0 かつユーザー ワークロードの CPU 0", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-auto-pause-resume?view=azuresql", "locator": "自動一時停止", "retrievedAt": "2026-10-14T22:50:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "最小の自動一時停止遅延は 60 分（既定も 60 分）。無効化は -1", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-auto-pause-resume?view=azuresql", "locator": "制限事項", "retrievedAt": "2026-10-14T22:50:00Z" }] },
            { "text": "プレビュー中、名前付きレプリカは自動一時停止・再開に未対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-auto-pause-resume?view=azuresql", "locator": "制限事項", "retrievedAt": "2026-10-14T22:50:00Z" }] },
            { "text": "ジオレプリケーション・LTR・DNS エイリアスの利用中は自動一時停止されない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-auto-pause-resume?view=azuresql", "locator": "自動一時停止を防ぐ機能", "retrievedAt": "2026-10-14T22:50:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "再開時の初回接続はエラー 40613 になり得るため、接続の再試行ロジックを備える", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/azure-sql/database/serverless-tier-auto-pause-resume?view=azuresql", "locator": "自動再開接続のトラブルシューティング", "retrievedAt": "2026-10-14T22:50:00Z" }] },
            { "text": "まず検証環境で、アイドル時間の長さと再開遅延の許容度を確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
      ],
