      "audience": {
        "who": { "text": "アイドル時間が長い・予測できる **Hyperscale サーバーレス** データベースの利用者", "origin": "mrc", "assertion": "inference", "verification": "source-only" },
        "change": { "text": "非アクティブ時にコンピューティング課金を止め、コストを抑えられる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
