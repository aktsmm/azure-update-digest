      "kindSource": "ring",
      "label": "GA",
      "title": {
        "ja": "Site Recovery が VMSS Flex の VM 保護を強化（GA）",
        "subtitleJa": "ターゲット スケール セットを指定して、フェールオーバー・再保護・フェールバックまで実行できます",
        "en": "Generally Available: Enhanced Azure Site Recovery support for VMSS Flex"
      },
      "meta": {
        "publishedJst": "2026-11-04",
        "availability": [{ "rawRing": "General Availability", "year": 2026, "month": "October" }],
        "status": "Launched",
        "products": ["Azure Site Recovery"],
        "categories": ["compute", "ops-governance"],
        "importance": "notable"
      },
      "audience": {
        "who": { "text": "フレキシブル オーケストレーションの **Virtual Machine Scale Sets 内の VM** を災害復旧したい方", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "ターゲット構成が改善され、復旧ワークフローを一貫して実行できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "VMSS Flex の VM を保護する計画があれば検討", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
      },
      "panels": [
        {
          "id": "how-it-works", "heading": "仕組み", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "スケール セット内の各 VM を個別の複製アイテムとして保護する（スケール セット単位では有効化しない）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "どのように機能するのか", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            {
              "text": "フェールオーバー時、回復 VM をターゲット スケール セットと設定したゾーン・フォールト ドメインに配置する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "どのように機能するのか", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            {
              "text": "再保護とフェイルバックでワークロードを元のソース VM に戻せる",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "再保護とフェイルバック", "retrievedAt": "2026-11-04T23:33:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start", "heading": "設定の流れ（Azure portal）", "availability": "present", "priority": "core",
          "items": [
            {
              "text": "復旧先にターゲットのフレキシブル スケール セットを作成してから、VM のレプリケーションを有効化",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "ターゲットスケールセットを準備します", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            {
              "text": "ターゲットの可用性で「仮想マシン スケール セット (フレキシブル)」を選び、ターゲット スケール セットを指定",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "レプリケーションを有効にする", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            {
              "text": "テスト フェールオーバーで検証後、フェールオーバー → 再保護 → フェイルバック",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "テスト フェールオーバーの実行", "retrievedAt": "2026-11-04T23:33:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提・制限", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ターゲット スケール セットは自分で作成。Site Recovery は設定・VM プロファイルを複製しない",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "Limitations", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            {
              "text": "保護後はターゲットのゾーン・フォールト ドメインを変更不可（再有効化が必要）",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "Limitations", "retrievedAt": "2026-11-04T23:33:00Z" }]
            }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "ゾーン間 DR は、ゾーン対応スケール セット内の VM と単一インスタンス ゾーン VM が対象。リージョン VM・可用性セットの VM は対象外",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "ソースVM展開", "retrievedAt": "2026-11-04T23:33:00Z" }]
            }
          ]
        },
        {
          "id": "use-case", "heading": "使いどころ・注意", "availability": "present", "priority": "detail",
          "items": [
            {
              "text": "複数 VM をまとめてフェールオーバーするにはリカバリ プランに追加する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "どのように機能するのか", "retrievedAt": "2026-11-04T23:33:00Z" }]
            },
            { "text": "本番切替前にテスト フェールオーバーで配置先のゾーンを確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
      ],
      "glossary": [
        { "termKey": "asr", "term": "Azure Site Recovery", "type": "product", "oneLine": { "text": "VM を別のリージョンやゾーンへレプリケートして、災害復旧を行うサービス。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "冒頭", "retrievedAt": "2026-11-04T23:33:00Z" }] } },
        { "termKey": "vmss-flex", "term": "VMSS Flex", "type": "feature", "oneLine": { "text": "Flexible オーケストレーションを使う Virtual Machine Scale Sets のこと。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "冒頭", "retrievedAt": "2026-11-04T23:33:00Z" }] } },
