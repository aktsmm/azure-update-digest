        { "termKey": "reprotect-failback", "term": "再保護 / フェイルバック", "type": "term", "oneLine": { "text": "フェールオーバー後に元の場所へ複製し直し、ワークロードを戻すこと。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/site-recovery/azure-to-azure-how-to-enable-replication-vmss-flex", "locator": "再保護の有効化とフェイルバック", "retrievedAt": "2026-11-04T23:33:00Z" }] } },
        { "termKey": "label-ga", "term": "GA（一般提供）", "type": "label", "oneLine": { "text": "機能が完全にリリースされ、本番利用でサポートされる段階。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/lifecycle/faq/azure-infrastructure", "locator": "General availability (GA)", "retrievedAt": "2026-11-04T23:33:00Z" }] } }
      ],
