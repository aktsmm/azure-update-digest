      "audience": {
        "who": { "text": "**Microsoft Foundry** のモデルやエージェントの支出を管理する管理者・FinOps・開発者", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "冒頭", "retrievedAt": "2026-11-26T02:00:00Z" }] },
        "change": { "text": "請求書に反映される前に、予算超過をアラートやブロックで抑えられる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "冒頭", "retrievedAt": "2026-11-26T02:00:00Z" }] },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "プレビューのため本番利用は非推奨。まず監視用途で評価", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "Important", "retrievedAt": "2026-11-26T02:00:00Z" }] }
      },
      "beforeAfter": {
        "after": {
          "text": "リソースやプロジェクトに支出またはトークンの予算を設定し、しきい値到達時に Event Grid でアラート、または新規リクエストをブロックできる",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象は GPT モデルと OpenAI o-series。Claude や DeepSeek などは未対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "What's supported in this preview", "retrievedAt": "2026-11-26T02:00:00Z" }] },
            { "text": "適用範囲は全体、プロジェクト、デプロイ、エージェント、セッションで絞り込み可", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "予算は日次・週次・月次でリセット", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "支出額は推定値で、Azure の請求とは照合されない", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "設定の反映は最大 15 分。しきい値を超えるリクエストは完了することがある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "How cost controls work", "retrievedAt": "2026-11-26T02:00:00Z" }] },
            { "text": "PTU デプロイ、エージェントのツール課金、ホスト型の計算は集計対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "What's supported in this preview", "retrievedAt": "2026-11-26T02:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits", "heading": "前提条件", "availability": "present", "priority": "detail",
          "items": [
            { "text": "アラート送信には CloudEvents v1.0 スキーマの Event Grid トピックが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/how-to/create-cost-controls", "locator": "Prerequisites", "retrievedAt": "2026-11-26T02:00:00Z" }] },
            { "text": "使用状況の表示には Application Insights が必要（アラートとブロックには不要）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/how-to/create-cost-controls", "locator": "Prerequisites", "retrievedAt": "2026-11-26T02:00:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Azure Cost Management の予算はアラートのみ。コスト制御はリクエストをブロックできる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "Compare cost controls with other ways to manage spending", "retrievedAt": "2026-11-26T02:00:00Z" }] },
            { "text": "クォータはスループットの制限で、コスト制御は支出・トークンの上限", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "Compare cost controls with other ways to manage spending", "retrievedAt": "2026-11-26T02:00:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "しきい値なしで使用状況の追跡だけ行い、実績を見てからブロックを検討する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/cost-controls", "locator": "How cost controls work", "retrievedAt": "2026-11-26T02:00:00Z" }] },
            { "text": "80% でアラート、100% でブロックの組み合わせを検証環境で試す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
