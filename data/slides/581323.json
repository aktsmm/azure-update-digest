      "audience": {
        "who": { "text": "Foundry でモデルやエージェントを運用する**プラットフォーム管理者・FinOps 担当者・プロジェクト リード**", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "冒頭", "retrievedAt": "2026-11-27T13:10:00Z" }] },
        "change": { "text": "請求書に反映される前に、使用量ベースで予算超過を検知・防止できる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "プレビューのため、運用ワークロードへの利用は推奨されていない。まず評価から", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "Important", "retrievedAt": "2026-11-27T13:10:00Z" }] }
      },
      "beforeAfter": {
        "after": {
          "text": "リソースやプロジェクトに予算を設定し、しきい値到達時に Event Grid でアラート、または新規リクエストをブロックできる。リセットは日・週・月単位",
          "origin": "mrc", "assertion": "fact", "verification": "source-only"
        }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "対象: Azure OpenAI のモデル デプロイ（GPT / o-series）。他社モデルは未対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "このプレビューでサポートされる内容", "retrievedAt": "2026-11-27T13:10:00Z" }] },
            { "text": "適用範囲: プロジェクト・デプロイ・エージェント・セッションで絞り込める", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "アクション: Event Grid でアラート送信、または新規リクエストをブロック", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "支出額は推定値で、請求額とは照合されない", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
            { "text": "変更の反映に最大 15 分。しきい値をわずかに超える場合がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト管理のしくみ", "retrievedAt": "2026-11-27T13:10:00Z" }] },
            { "text": "PTU デプロイと、Web 検索などのエージェント ツール料金は対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "このプレビューでサポートされる内容", "retrievedAt": "2026-11-27T13:10:00Z" }] }
          ]
        },
        {
          "id": "prerequisites", "heading": "前提・必要なロール", "availability": "present", "priority": "detail",
          "items": [
            { "text": "作成には Foundry Account Owner / Owner など。リソース単位は Foundry Owner も可", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/how-to/create-cost-controls", "locator": "前提条件", "retrievedAt": "2026-11-27T13:10:00Z" }] },
            { "text": "アラート送信には Event Grid トピック（CloudEvents v1.0）が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/how-to/create-cost-controls", "locator": "前提条件", "retrievedAt": "2026-11-27T13:10:00Z" }] }
          ]
        },
        {
          "id": "related-features", "heading": "似た機能との違い", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Azure Cost Management の予算は、リクエストのブロックができない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト管理と支出を管理する他の方法を比較する", "retrievedAt": "2026-11-27T13:10:00Z" }] },
            { "text": "クォータはスループットを制限し、コスト制御は期間ごとの支出・トークンを制限", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト管理と支出を管理する他の方法を比較する", "retrievedAt": "2026-11-27T13:10:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "80% でアラート、100% でブロックの組み合わせで、まず検証環境で挙動を確認する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            { "text": "しきい値アクションなしで作成すると、リクエストに影響せず使用量だけ追跡できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト管理のしくみ", "retrievedAt": "2026-11-27T13:10:00Z" }] }
          ]
        }
