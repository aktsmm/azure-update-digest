      "title": {
        "ja": "Microsoft Foundry にコスト制御がパブリック プレビューで登場",
        "subtitleJa": "モデル・エージェントの支出やトークンに予算を設定し、アラートまたはブロックが可能に",
        "en": "Public Preview: Cost controls for model and agent spending in Microsoft Foundry"
      },
      "meta": {
        "publishedJst": "2026-11-25",
        "modifiedJst": "2026-11-25",
        "availability": [{ "rawRing": "Preview", "year": 2026, "month": "November" }],
        "status": "In preview",
        "products": ["Microsoft Foundry"],
        "categories": ["ai"],
        "importance": "normal"
      },
      "audience": {
        "who": { "text": "Foundry で **モデルやエージェントの利用コストを管理する管理者・FinOps 担当・開発者**", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "冒頭", "retrievedAt": "2026-11-28T08:30:00Z" }] },
        "change": { "text": "コストが請求に現れる前に、使用量に応じてアラートやブロックができる", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "changeNature": "benefit"
      },
      "action": {
        "required": "optional",
        "summary": { "text": "本番利用は非推奨のため、まず評価目的で試す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "Important", "retrievedAt": "2026-11-28T08:30:00Z" }] }
      },
      "beforeAfter": {
        "after": { "text": "リソースやプロジェクトに支出・トークンの予算を設定し、しきい値でアラート送信または新規リクエストのブロックができる", "origin": "mrc", "assertion": "fact", "verification": "source-only" }
      },
      "panels": [
        {
          "id": "scope", "heading": "プレビューの範囲", "availability": "present", "priority": "core",
          "items": [
            { "text": "予算はすべての使用量、またはプロジェクト・デプロイ・エージェント・セッションで絞り込める", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト制御が適用できるもの", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "予算は日次・週次・月次でリセット。種類は支出（USD）かトークン", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "予算の種類", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "しきい値の動作は Azure Event Grid へのアラート送信、または新規リクエストのブロック", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "しきい値アクション", "retrievedAt": "2026-11-28T08:30:00Z" }] }
          ]
        },
        {
          "id": "constraints", "heading": "制約・注意", "availability": "present", "priority": "core",
          "items": [
            { "text": "プレビューでは GPT と OpenAI o シリーズのモデルが対象。他社モデルは非対応", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "このプレビューでサポートされるもの", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "支出額は推定値で請求とは照合されず、実際より早く上限に達しうる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト制御による使用量の価格設定", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "PTU デプロイ、エージェントのツール料金、ホスト型エージェントのコンピューティングは集計対象外", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "このプレビューでサポートされるもの", "retrievedAt": "2026-11-28T08:30:00Z" }] }
          ]
        },
        {
          "id": "evaluate", "heading": "評価ポイント", "availability": "present", "priority": "detail",
          "items": [
            { "text": "アラートには Event Grid トピック（CloudEvents v1.0・キー認証）、使用量表示には Application Insights が必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/how-to/create-cost-controls", "locator": "前提条件", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "変更の反映に最大 15 分かかり、その間は上限を超える可能性がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "制限事項", "retrievedAt": "2026-11-28T08:30:00Z" }] }
          ]
        },
        {
          "id": "compare", "heading": "他の支出管理との比較", "availability": "present", "priority": "detail",
          "items": [
            { "text": "Azure Cost Management の予算はアラートのみ。コスト制御はリクエストのブロックも可能", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "他の支出管理方法との比較", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "クォータはスループットの保護、コスト制御は支出やトークンの上限と役割が異なる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "他の支出管理方法との比較", "retrievedAt": "2026-11-28T08:30:00Z" }] }
          ]
        },
        {
          "id": "usage", "heading": "使い方の目安", "availability": "present", "priority": "detail",
          "items": [
            { "text": "80% でアラート、100% でブロックのように、ブロックの前にアラートを組み合わせる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト制御による使用量の価格設定", "retrievedAt": "2026-11-28T08:30:00Z" }] },
            { "text": "しきい値アクションなしなら、リクエストに影響せず使用量だけを追跡できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/foundry/concepts/cost-controls", "locator": "コスト制御のしくみ", "retrievedAt": "2026-11-28T08:30:00Z" }] }
          ]
        }
      ],
