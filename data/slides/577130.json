        { "termKey": "rbac", "term": "RBAC", "type": "term", "oneLine": { "text": "ロールの割り当てによって、リソースやキーへのアクセスを制御する仕組み。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/azure/key-vault/managed-hsm/overview", "locator": "分離アクセス制御", "retrievedAt": "2026-10-25T20:45:00Z" }] } },
        { "termKey": "label-ga", "term": "GA（一般提供）", "type": "label", "oneLine": { "text": "機能が完全にリリースされ、本番利用でサポートされる段階。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/lifecycle/faq/azure-infrastructure", "locator": "General availability (GA)", "retrievedAt": "2026-10-25T20:45:00Z" }] } }
